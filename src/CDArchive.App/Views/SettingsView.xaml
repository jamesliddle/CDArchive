<UserControl x:Class="CDArchive.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:svc="clr-namespace:CDArchive.Core.Services;assembly=CDArchive.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="600" HorizontalAlignment="Left">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Archive Root Path -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="Archive Root Path"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Text="{Binding ArchiveRootPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     FontSize="14"
                     Padding="8,6"
                     Margin="0,0,10,0" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="Browse..."
                    Command="{Binding BrowseArchivePathCommand}"
                    FontSize="13"
                    Padding="15,6"
                    Background="#555555"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />

            <!-- FFmpeg Path -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="FFmpeg Path"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     FontSize="14"
                     Padding="8,6"
                     Margin="0,0,10,0" />
            <Button Grid.Row="2" Grid.Column="2"
                    Content="Browse..."
                    Command="{Binding BrowseFfmpegPathCommand}"
                    FontSize="13"
                    Padding="15,6"
                    Background="#555555"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand" />

            <!-- MP3 Bitrate -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="MP3 Bitrate"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Row="4" Grid.Column="1"
                      SelectedItem="{Binding Mp3Bitrate, Mode=TwoWay}"
                      FontSize="14"
                      Padding="8,6"
                      Width="120"
                      HorizontalAlignment="Left">
                <sys:Int32>128</sys:Int32>
                <sys:Int32>192</sys:Int32>
                <sys:Int32>256</sys:Int32>
                <sys:Int32>320</sys:Int32>
            </ComboBox>

            <!-- Preferred audio format for the music player -->
            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="Player Format"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#333333"
                       VerticalAlignment="Center"
                       ToolTip="Format the music player prefers when both FLAC and MP3 exist for a track. Falls back to the other format if the preferred one is missing." />
            <ComboBox Grid.Row="6" Grid.Column="1"
                      SelectedItem="{Binding PreferredAudioFormat, Mode=TwoWay}"
                      FontSize="14"
                      Padding="8,6"
                      Width="120"
                      HorizontalAlignment="Left">
                <svc:PreferredAudioFormat>Flac</svc:PreferredAudioFormat>
                <svc:PreferredAudioFormat>Mp3</svc:PreferredAudioFormat>
            </ComboBox>
        </Grid>

        <!-- MusicBrainz import enrichment section (slice 6) -->
        <GroupBox Header="MusicBrainz Import Enrichment" Margin="0,30,0,0" Padding="10" FontSize="13">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#555" Margin="0,0,0,10">
                    When enabled, the iTunes import flow runs an optional
                    pre-pass that queries MusicBrainz for album, composer, and
                    work metadata. A review pane lets you accept or reject each
                    suggestion before the import is applied. Disabled by default.
                </TextBlock>

                <CheckBox Content="Enable MusicBrainz import enrichment"
                          IsChecked="{Binding EnableMusicBrainzImportEnrichment, Mode=TwoWay}"
                          FontSize="13" Margin="0,0,0,8" />

                <Grid Margin="20,0,0,0"
                      IsEnabled="{Binding EnableMusicBrainzImportEnrichment}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Candidates per proposal" FontSize="12"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              SelectedItem="{Binding MusicBrainzCandidatesPerProposal, Mode=TwoWay}"
                              FontSize="12" Width="80" HorizontalAlignment="Left">
                        <sys:Int32>1</sys:Int32>
                        <sys:Int32>2</sys:Int32>
                        <sys:Int32>3</sys:Int32>
                        <sys:Int32>5</sys:Int32>
                        <sys:Int32>10</sys:Int32>
                        <sys:Int32>15</sys:Int32>
                        <sys:Int32>20</sys:Int32>
                        <sys:Int32>25</sys:Int32>
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2"
                               Text="Default apply state in review pane:"
                               FontSize="12" Foreground="#555" Margin="0,6,0,4" />

                    <CheckBox Grid.Row="3" Grid.ColumnSpan="2"
                              Content="Album metadata (Label / Catalogue Number / Barcode)"
                              IsChecked="{Binding ApplyMbAlbumMetadata, Mode=TwoWay}"
                              FontSize="12" Margin="0,2" />
                    <CheckBox Grid.Row="4" Grid.ColumnSpan="2"
                              Content="Album performer credits (conductor / orchestra / soloists)"
                              IsChecked="{Binding ApplyMbPerformerCredits, Mode=TwoWay}"
                              FontSize="12" Margin="0,2" />
                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                        <CheckBox Content="Album recording session (date / venue / engineers)"
                                  IsChecked="{Binding ApplyMbRecordingSessions, Mode=TwoWay}"
                                  FontSize="12" Margin="0,2" />
                    </StackPanel>
                </Grid>

                <!-- Connectivity diagnostic — does NOT require master switch.
                     Lets the user verify MB is reachable + the query format
                     works against real data, independent of the iTunes import
                     workflow. -->
                <Border BorderBrush="#D0D0D0" BorderThickness="0,1,0,0"
                        Padding="0,10,0,0" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Diagnostics" FontWeight="SemiBold" FontSize="12"
                                   Foreground="#555" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666" Margin="0,0,0,6">
                            Runs a real MusicBrainz release-search ("Beethoven Symphony 9, Karajan")
                            and reports the outcome. Use this to verify connectivity + query format
                            when imports yield no matches.
                        </TextBlock>
                        <Button Content="Test MusicBrainz connectivity"
                                Command="{Binding TestMbConnectivityCommand}"
                                FontSize="12" Padding="10,4" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding MbConnectivityStatus}"
                                   TextWrapping="Wrap" FontSize="11" Foreground="#444"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </GroupBox>

        <!-- Save Button -->
        <Button Content="Save Settings"
                Command="{Binding SaveCommand}"
                FontSize="14"
                Padding="20,8"
                HorizontalAlignment="Left"
                Background="#007ACC"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Margin="0,25,0,15" />

        <!-- Status Message -->
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="14"
                   Foreground="#555555"
                   TextWrapping="Wrap" />
    </StackPanel>
    </ScrollViewer>
</UserControl>
