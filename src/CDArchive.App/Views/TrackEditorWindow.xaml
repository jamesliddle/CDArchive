<Window x:Class="CDArchive.App.Views.TrackEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Title="Edit Track"
        Width="640" Height="720"
        MaxHeight="720"
        MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Vertical action-button stack style, shared by the Engineer +
             Producer lists. Same shape used in AlbumEditorWindow. -->
        <Style x:Key="ListActionButtonStyle" TargetType="Button">
            <Setter Property="Width"   Value="74" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Margin"  Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">

        <!-- Navigation (left) + OK/Cancel (right) -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel x:Name="NavigationPanel"
                        DockPanel.Dock="Left" Orientation="Horizontal"
                        Visibility="{Binding ShowNavigation,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource BoolToVis}}">
                <Button x:Name="PrevButton" Content="◀" Width="32" Padding="0,6"
                        IsEnabled="False" Click="OnPrevClick"
                        ToolTip="Previous track — saves current changes" />
                <Button x:Name="NextButton" Content="▶" Width="32" Padding="0,6"
                        Margin="4,0,0,0" Click="OnNextClick"
                        ToolTip="Next track — saves current changes" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="OK" Width="80" Padding="0,6"
                        IsDefault="True" Click="OnOkClick" />
                <Button Content="Cancel" Width="80" Padding="0,6" Margin="8,0,0,0"
                        IsCancel="True" />
            </StackPanel>
        </DockPanel>

        <!-- Main scrollable content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Piece References -->
                <GroupBox x:Name="PieceRefsGroup" Header="Piece References"
                          Margin="0,0,0,10" Padding="8">
                    <DockPanel>
                        <TextBlock x:Name="PieceRefsMixedNote"
                                   DockPanel.Dock="Top"
                                   Text="Mixed — piece references differ across selected tracks. Entries added here are APPENDED to each track's existing list; existing entries are preserved."
                                   Foreground="DarkGray" FontStyle="Italic"
                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="Collapsed" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                            <Button x:Name="AddPieceRefButton" Content="Add"
                                    Padding="10,4" Click="OnAddPieceRef" />
                            <Button x:Name="EditPieceRefButton" Content="Details…"
                                    Padding="10,4" Margin="6,0,0,0"
                                    ToolTip="Set start/end markers and range across sibling subpieces"
                                    IsEnabled="False" Click="OnEditPieceRefDetails" />
                            <Button x:Name="RemovePieceRefButton" Content="Remove"
                                    Padding="10,4" Margin="6,0,0,0"
                                    IsEnabled="False" Click="OnRemovePieceRef" />
                            <Button x:Name="PieceRefUpButton" Content="Up"
                                    Padding="10,4" Margin="6,0,0,0"
                                    IsEnabled="False" Click="OnPieceRefMoveUp" />
                            <Button x:Name="PieceRefDownButton" Content="Down"
                                    Padding="10,4" Margin="6,0,0,0"
                                    IsEnabled="False" Click="OnPieceRefMoveDown" />
                            <Button x:Name="EditRootPieceButton" Content="Edit Root Piece…"
                                    Padding="10,4" Margin="6,0,0,0"
                                    ToolTip="Open the top-level ancestor piece in the Piece editor"
                                    IsEnabled="False" Click="OnEditRootPiece" />
                        </StackPanel>
                        <ListBox x:Name="PieceRefList" MinHeight="80" MaxHeight="160"
                                 BorderThickness="1" BorderBrush="#CCC" Margin="0,6,0,0"
                                 SelectionChanged="OnPieceRefSelectionChanged"
                                 MouseDoubleClick="OnPieceRefDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <!-- Unchosen-variant flag: the ref's piece
                                             has variants but none are identified. -->
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="⚑" Margin="0,0,5,0"
                                                   Foreground="#C77A00"
                                                   ToolTip="This piece has variants — none identified. Use Details… to pick."
                                                   Visibility="{Binding Converter={StaticResource RefNeedsVariant}}" />
                                        <TextBlock Text="{Binding DisplaySummary}"
                                                   TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </GroupBox>

                <!-- Description -->
                <GroupBox Header="Description" Margin="0,0,0,10" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Used for tracks not linked to the Canon (e.g. 'Interview with Brendel')"
                                   FontSize="9" Foreground="#888" TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBox x:Name="DescriptionBox" Height="50"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 FontSize="11" Padding="4,3"
                                 Text="{Binding Description.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </GroupBox>

                <!-- Track Info -->
                <GroupBox Header="Track Info" Margin="0,0,0,10" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Track Number -->
                        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="TrackNumberLabel"
                                   Text="Track #:"
                                   VerticalAlignment="Center" Margin="0,0,8,8"
                                   Visibility="{Binding ShowTrackNumber,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolToVis}}" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TrackNumberBox"
                                 Width="60" HorizontalAlignment="Left"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 Text="{Binding TrackNumber.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowTrackNumber,
                                                       RelativeSource={RelativeSource AncestorType=Window},
                                                       Converter={StaticResource BoolToVis}}" />

                        <!-- Duration -->
                        <TextBlock Grid.Row="1" Grid.Column="0" x:Name="DurationLabel"
                                   Text="Duration:"
                                   VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="DurationBox"
                                 Width="100" HorizontalAlignment="Left"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 Text="{Binding Duration.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="e.g. 5:32 or 1:02:15" />

                        <!-- SPARS Code -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="SPARS Code:"
                                   VerticalAlignment="Center" Margin="0,0,8,8"
                                   ToolTip="Track-level SPARS code. Changing the album-level value pushes the new value to every track." />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TrackSparsCodeBox"
                                  Width="100" HorizontalAlignment="Left"
                                  FontSize="11" Margin="0,0,0,8"
                                  SelectionChanged="OnSparsCodeChanged"
                                  ToolTip="D=digital, A=analogue: recording / mixing / mastering">
                            <ComboBoxItem Content="DDD" />
                            <ComboBoxItem Content="ADD" />
                            <ComboBoxItem Content="AAD" />
                            <ComboBoxItem Content="Unknown" />
                        </ComboBox>

                        <!-- Stereo -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Stereo:"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="Track-level stereo setting. Changing the album-level value pushes the new value to every track." />
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="TrackStereoBox"
                                  Width="120" HorizontalAlignment="Left"
                                  FontSize="11"
                                  SelectionChanged="OnStereoChanged">
                            <ComboBoxItem Content="Unknown" />
                            <ComboBoxItem Content="Stereo" />
                            <ComboBoxItem Content="Mono" />
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <!-- Recording Session — blank fields default to the parent
                     album's values on open; the user can override per track. -->
                <GroupBox Header="Recording Session" Margin="0,0,0,10" Padding="8"
                          Visibility="{Binding ShowSessionFields,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dates:"
                                   VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SessionDatesBox"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 Text="{Binding SessionDates.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Freeform date, e.g. 'March 3–7, 1967'. Defaults from the album." />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Venue:"
                                   VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SessionVenueBox"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 Text="{Binding SessionVenue.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="City:"
                                   VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="SessionCityBox"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 Text="{Binding SessionCity.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="State:"
                                   VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="SessionStateBox"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 Text="{Binding SessionState.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Country:"
                                   VerticalAlignment="Center" Margin="0,0,8,8" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="SessionCountryBox"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 Text="{Binding SessionCountry.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Engineers list (hidden in multi-edit) -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Engineers:"
                                   VerticalAlignment="Top" Margin="0,4,8,8"
                                   Visibility="{Binding ShowSessionLists,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolToVis}}" />
                        <Grid Grid.Row="5" Grid.Column="1" Height="175" Margin="0,0,0,8"
                              Visibility="{Binding ShowSessionLists,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="SessionEngineerList" Grid.Column="0" FontSize="11"
                                     BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                                     ItemsSource="{Binding SessionEngineers}"
                                     SelectionChanged="OnSessionEngineerSelectionChanged"
                                     MouseDoubleClick="OnSessionEngineerDoubleClick" />
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="AddSessionEngineerButton" Content="Add"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        Click="OnAddSessionEngineer" />
                                <Button x:Name="EditSessionEngineerButton" Content="Edit"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnEditSessionEngineer" />
                                <Button x:Name="RemoveSessionEngineerButton" Content="Remove"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnRemoveSessionEngineer" />
                                <Border Height="1" Background="#DDD" Margin="0,2,0,2" />
                                <Button x:Name="SessionEngineerUpButton" Content="Up"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionEngineerMoveUp" />
                                <Button x:Name="SessionEngineerDownButton" Content="Down"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionEngineerMoveDown" />
                            </StackPanel>
                        </Grid>

                        <!-- Producers list (hidden in multi-edit) -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Producers:"
                                   VerticalAlignment="Top" Margin="0,4,8,0"
                                   Visibility="{Binding ShowSessionLists,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolToVis}}" />
                        <Grid Grid.Row="6" Grid.Column="1" Height="175"
                              Visibility="{Binding ShowSessionLists,
                                                    RelativeSource={RelativeSource AncestorType=Window},
                                                    Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="SessionProducerList" Grid.Column="0" FontSize="11"
                                     BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                                     ItemsSource="{Binding SessionProducers}"
                                     SelectionChanged="OnSessionProducerSelectionChanged"
                                     MouseDoubleClick="OnSessionProducerDoubleClick" />
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="AddSessionProducerButton" Content="Add"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        Click="OnAddSessionProducer" />
                                <Button x:Name="EditSessionProducerButton" Content="Edit"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnEditSessionProducer" />
                                <Button x:Name="RemoveSessionProducerButton" Content="Remove"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnRemoveSessionProducer" />
                                <Border Height="1" Background="#DDD" Margin="0,2,0,2" />
                                <Button x:Name="SessionProducerUpButton" Content="Up"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionProducerMoveUp" />
                                <Button x:Name="SessionProducerDownButton" Content="Down"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionProducerMoveDown" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Per-track audio file overrides — set these only when the
                     locator's convention (album folder / format subfolder /
                     track-number prefix) can't find this track's audio. -->
                <GroupBox x:Name="AudioOverridesGroup"
                          Header="Audio file overrides" Margin="0,0,0,10" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Leave blank to use the album / disc / track convention. Set when the file lives somewhere unusual (e.g. a standalone MP3 in your Music folder)."
                                   FontSize="9" Foreground="#888" TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="FLAC file:"
                                       VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="FlacPathBox"
                                     FontSize="11" Padding="4,3" Margin="0,0,6,4"
                                     Text="{Binding FlacPath.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Absolute path to this track's FLAC file." />
                            <Button Grid.Row="0" Grid.Column="2" Content="Browse…"
                                    Padding="8,3" Margin="0,0,0,4"
                                    Click="OnBrowseFlacPath" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="MP3 file:"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="Mp3PathBox"
                                     FontSize="11" Padding="4,3" Margin="0,0,6,0"
                                     Text="{Binding Mp3Path.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Absolute path to this track's MP3 file." />
                            <Button Grid.Row="1" Grid.Column="2" Content="Browse…"
                                    Padding="8,3"
                                    Click="OnBrowseMp3Path" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Performers — same Grid + vertical button-stack layout as
                     the AlbumEditor's Performers section for consistency. -->
                <GroupBox x:Name="PerformerOverrideGroup"
                          Header="Performers" Margin="0,10,0,0" Padding="8">
                    <DockPanel>
                        <TextBlock x:Name="PerformerMixedNote"
                                   DockPanel.Dock="Top"
                                   Text="Mixed — performer lists differ across selected tracks. Entries added here are APPENDED to each track's existing list; existing entries are preserved."
                                   Foreground="DarkGray" FontStyle="Italic"
                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="Collapsed" />
                        <Grid Height="175">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- ItemsSource set in code-behind via
                                 _vm.Performers.Items (consistent with
                                 PieceRefList in this same window). -->
                            <ListView x:Name="TrackPerformerList" Grid.Column="0" FontSize="11"
                                      BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                                      AlternationCount="2"
                                      ItemContainerStyle="{StaticResource ZebraListViewItemStyle}"
                                      SelectionChanged="OnTrackPerformerSelectionChanged"
                                      MouseDoubleClick="OnTrackPerformerDoubleClick">
                                <ListView.View>
                                    <GridView x:Name="TrackPerformerGridView">
                                        <GridViewColumn Header="Name" Width="180">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="TrackPerformerRoleColumn"
                                                        Header="Role" Width="120">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Role}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Instrument" Width="140">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Instrument}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="AddTrackPerformerButton" Content="Add"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        Click="OnAddTrackPerformer" />
                                <Button x:Name="EditTrackPerformerButton" Content="Edit"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnEditTrackPerformer" />
                                <Button x:Name="RemoveTrackPerformerButton" Content="Remove"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnRemoveTrackPerformer" />
                                <Border Height="1" Background="#DDD" Margin="0,2,0,2" />
                                <Button x:Name="TrackPerformerUpButton" Content="Up"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnTrackPerformerMoveUp" />
                                <Button x:Name="TrackPerformerDownButton" Content="Down"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnTrackPerformerMoveDown" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
