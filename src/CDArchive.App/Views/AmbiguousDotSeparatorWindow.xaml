<Window x:Class="CDArchive.App.Views.AmbiguousDotSeparatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Title="Resolve ambiguous '. ' separators"
        Width="895" Height="540"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="11">
            Some iTunes track names use '<Bold>. </Bold>' which can mean either a
            <Bold>subpiece hierarchy</Bold> (Requiem-style, e.g. "Dies irae. Tuba mirum"
            = two sections) or a <Bold>form + tempo</Bold> indication (instrumental-sonata
            style, e.g. "Scherzando. Allegretto, ma non troppo" = one movement with form
            "Scherzando" and tempo "Allegretto, ma non troppo"). Pick the interpretation
            for each track below.
        </TextBlock>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Height="24" IsDefault="True"
                    Click="OnOkClick" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="80" Height="24" IsCancel="True" />
        </StackPanel>

        <ListView x:Name="ItemsList" ItemsSource="{Binding Items}"
                  AlternationCount="2"
                  ItemContainerStyle="{StaticResource ZebraListViewItemStyle}"
                  FontSize="11">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Track Name" Width="500">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TrackName}"
                                           TextWrapping="Wrap" Padding="4,2" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Ambiguous segment" Width="180">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AmbiguousDisplay}"
                                           TextWrapping="Wrap" Padding="4,2"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Interpretation" Width="120">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding Choice, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          Padding="4,2">
                                    <ComboBoxItem Content="Form + tempo" Tag="FormAndTempo" />
                                    <ComboBoxItem Content="Subpiece hierarchy" Tag="SubpieceHierarchy" />
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
