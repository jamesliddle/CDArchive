<Window x:Class="CDArchive.App.Views.MarkerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Title="Edit Marker" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Kind" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,0,8,0" />
            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="KindCombo"
                       FontSize="11" Padding="4,3" Margin="0,3"
                       Width="180" HorizontalAlignment="Left"
                       ItemsSource="{Binding KindOptions}"
                       DisplayMemberPath="Label"
                       SelectedValuePath="Kind"
                       SelectedValue="{Binding Kind, Mode=TwoWay}" />

            <TextBlock Grid.Row="1" Text="Value" VerticalAlignment="Top"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,8,8,0" />
            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ValueBox"
                       FontSize="11" Padding="4,3" Margin="0,3"
                       TextWrapping="Wrap" AcceptsReturn="True"
                       MinHeight="26"
                       Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Text="Bar Number" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,8,0" />
            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="BarNumberBox"
                       FontSize="11" Padding="4,3" Margin="0,3"
                       Width="80" HorizontalAlignment="Left"
                       Text="{Binding BarNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Text="Number" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,4,8,0" />
            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="NumberBox"
                       FontSize="11" Padding="4,3" Margin="0,3"
                       Width="60" HorizontalAlignment="Left"
                       Text="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="4" Text="Description" VerticalAlignment="Top"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,8,8,0" />
            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="DescriptionBox"
                       FontSize="11" Padding="4,3" Margin="0,3"
                       TextWrapping="Wrap" AcceptsReturn="True"
                       Height="60" VerticalScrollBarVisibility="Auto"
                       Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock Margin="0,10,0,0" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                   Text="Markers anchor album tracks to specific points in the music. Use Tempo for tempo indications, First Line for sung text incipits, Rehearsal Mark for score letters/numbers, and Bar Number when no other marker fits." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" Width="80" Padding="0,6"
                    IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" Width="80" Padding="0,6"
                    Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
