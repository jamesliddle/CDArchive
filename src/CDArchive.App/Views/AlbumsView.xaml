<UserControl x:Class="CDArchive.App.Views.AlbumsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:helpers="clr-namespace:CDArchive.App.Helpers"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             d:DataContext="{d:DesignInstance Type=vm:AlbumsViewModel}">

    <UserControl.Resources>
        <!-- Left-aligned header (default WPF centers; we want headers to
             match the left-aligned cell content). Defined here, not in
             ListView.Resources, because GridViewColumn lives outside the
             visual tree and HeaderContainerStyle's StaticResource lookup
             is more reliable from UserControl scope. -->
        <Style x:Key="LeftAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- Right-aligned header content. The default GridViewColumnHeader
             template doesn't reliably honour HorizontalContentAlignment="Right"
             (the sort-indicator chrome on the right edge reserves space), so
             we use HeaderTemplate + a stretching TextBlock with TextAlignment
             instead. HorizontalContentAlignment="Stretch" on the container is
             what lets the TextBlock fill the cell so TextAlignment has room
             to work. -->
        <Style x:Key="RightAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Shared template: binds to the Header value so the sort-arrow
             append in AlbumsView.OnColumnHeaderClick (which mutates
             header.Content) still surfaces. -->
        <DataTemplate x:Key="RightAlignedHeaderTemplate">
            <TextBlock Text="{Binding}" TextAlignment="Right" Padding="0,0,8,0" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource SurfaceBrush}" Padding="0,0,0,10" Margin="0,0,0,10">
            <DockPanel>

                <!-- Action buttons (right-docked so filter expands to fill) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="NewAlbumButton"
                            Content="New Album" Padding="12,5" FontSize="11"
                            Margin="0,0,6,0"
                            Click="OnNewAlbumClick" />
                    <Button x:Name="EditButton"
                            Content="Edit" Padding="12,5" FontSize="11"
                            Margin="0,0,6,0" IsEnabled="False"
                            Click="OnEditAlbumClick" />
                    <Button x:Name="DeleteButton"
                            Content="Delete" Padding="12,5" FontSize="11"
                            Margin="0,0,12,0" IsEnabled="False"
                            Click="OnDeleteAlbumClick" />
                    <Button Content="Check References" Padding="12,5" FontSize="11"
                            Margin="0,0,6,0"
                            ToolTip="Validate all track-to-piece links against the current Canon"
                            Command="{Binding CheckReferencesCommand}" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="32" Height="28"
                            ToolTip="Reload all data from the database"
                            Command="{Binding LoadDataCommand}" />
                </StackPanel>

                <!-- Filter (left side, fills remaining space) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBox x:Name="FilterBox"
                             Width="240" FontSize="11"
                             VerticalContentAlignment="Center"
                             TextChanged="OnFilterTextChanged" />

                    <TextBlock Text="Show:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox x:Name="ShowCombo" FontSize="11" Width="110"
                              SelectedIndex="0"
                              SelectionChanged="OnShowFilterChanged">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Provisional" />
                        <ComboBoxItem Content="Accepted" />
                    </ComboBox>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource StatusBarBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <!-- ── Album list ───────────────────────────────────────────────────── -->
        <ListView x:Name="AlbumList"
                  FontSize="11"
                  BorderThickness="0"
                  Background="{StaticResource SurfaceBrush}"
                  helpers:AutoSelectFirst.Enabled="True"
                  ItemsSource="{Binding Albums}"
                  SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                  SelectionMode="Extended"
                  SelectionChanged="OnAlbumSelectionChanged"
                  MouseDoubleClick="OnAlbumDoubleClick"
                  GridViewColumnHeader.Click="OnColumnHeaderClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <ListView.ContextMenu>
                <!-- H36: Approve / Reject are now RelayCommands on the VM.
                     PlacementTarget.SelectedItems is the standard pattern for
                     passing a ListView's multi-selection into a command from a
                     ContextMenu (ContextMenu lives outside the visual tree, so
                     ElementName binding won't reach back to the ListView). -->
                <ContextMenu Opened="OnAlbumContextMenuOpened">
                    <MenuItem Header="Play album" Click="OnContextPlayAlbum" />
                    <Separator />
                    <MenuItem x:Name="CtxApproveAlbum"
                              Header="Approve"
                              Command="{Binding PlacementTarget.DataContext.ApproveAlbumsCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem x:Name="CtxRejectAlbum"
                              Header="Reject"
                              Command="{Binding PlacementTarget.DataContext.RejectAlbumsCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </ListView.ContextMenu>


            <ListView.Resources>
                <!-- Subtle alternating row background -->
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"      Value="0,1" />
                    <Setter Property="MinHeight"    Value="18" />
                    <Setter Property="FontSize"     Value="11" />
                    <!-- Stretch the row presenter to fill the available width
                         so each cell occupies its full column width. Without
                         this, ListViewItem's default HorizontalContentAlignment
                         (Center) causes the GridViewRowPresenter to auto-size,
                         which collapses cells to their content and makes
                         HorizontalAlignment="Right" on inner TextBlocks have
                         no visible effect. -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ItemsControl.AlternationIndex" Value="1" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource ZebraRowBrush}" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.AlternationCount>2</ListView.AlternationCount>

            <ListView.View>
                <GridView>

                    <!-- Cover-art thumbnail. Resolves the album's cover (embedded
                         tag art first, then a folder image); placeholder otherwise.
                         The column width + box size are settings-driven: the box
                         binds ArtworkBoxSize; code-behind sets the column width
                         (0 when artwork is off). -->
                    <GridViewColumn x:Name="ArtworkColumn" Header="" Width="46"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="{Binding DataContext.ArtworkBoxSize, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        Height="{Binding DataContext.ArtworkBoxSize, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CornerRadius="4"
                                        Background="{StaticResource RailBackgroundBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left"
                                        Margin="0,1"
                                        Visibility="{Binding DataContext.ShowArtwork, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVis}}"
                                        ToolTipService.IsEnabled="{Binding Converter={StaticResource AlbumHasArtwork}}"
                                        ToolTipService.InitialShowDelay="350"
                                        ToolTipService.ShowDuration="120000"
                                        ToolTipService.Placement="Right">
                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource ArtworkPreviewToolTip}"
                                                 Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
                                    </Border.ToolTip>
                                    <Grid>
                                        <TextBlock Text="&#xEC4F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Converter={StaticResource AlbumArtwork},
                                                        ConverterParameter=96}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Title" Width="320"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayTitle}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayTitle}"
                                           Foreground="{Binding IsProvisional,
                                                        Converter={StaticResource ProvisionalBrush}}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Label" Width="140"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}"
                                    DisplayMemberBinding="{Binding Label}" />

                    <GridViewColumn Header="Cat. No." Width="110"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}"
                                    DisplayMemberBinding="{Binding CatalogueNumber}" />

                    <GridViewColumn Header="Performers" Width="220"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PerformerSummary}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding PerformerSummary}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="SPARS" Width="58"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}"
                                    DisplayMemberBinding="{Binding SparsCode}" />

                    <GridViewColumn Header="Discs" Width="48"
                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DiscCount}"
                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Tracks" Width="52"
                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalTrackCount}"
                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</UserControl>
