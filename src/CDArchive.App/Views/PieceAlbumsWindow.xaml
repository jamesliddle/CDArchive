<Window x:Class="CDArchive.App.Views.PieceAlbumsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        xmlns:local="clr-namespace:CDArchive.App.Views"
        Title="Albums referencing this piece"
        Width="640" Height="460"
        MinWidth="440" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="10">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top"
                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"
                   TextWrapping="Wrap" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button x:Name="OpenButton" DockPanel.Dock="Right"
                    Content="Open Album" Width="110" Padding="0,6"
                    IsEnabled="False" Click="OnOpenClick" />
            <Button x:Name="PlayButton" DockPanel.Dock="Right"
                    Content="Play" Width="80" Padding="0,6" Margin="0,0,8,0"
                    IsEnabled="False" Click="OnPlayClick" />
            <Button Content="Close" Width="80" Padding="0,6" Margin="0,0,8,0"
                    DockPanel.Dock="Right" IsCancel="True" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
        </DockPanel>

        <TreeView x:Name="HitTree" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                  AlternationCount="2"
                  SelectedItemChanged="OnTreeSelectionChanged"
                  MouseDoubleClick="OnTreeDoubleClick">
            <TreeView.Resources>
                <!-- Custom TreeViewItem template — same pattern as CanonView.
                     Putting the MinWidth=ViewportWidth binding directly on the
                     row Border (rather than via a Style Setter on TreeViewItem)
                     is what makes zebra stretch reliably; Setter+Binding+
                     RelativeSource resolution is flaky.
                     Per-level alternation caveat: expanded children restart at
                     AlternationIndex=0 (same as CanonView). -->
                <Style TargetType="TreeViewItem">
                    <Setter Property="Padding" Value="0,1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <StackPanel>
                                    <Border x:Name="Bd" Background="Transparent" Padding="0,1"
                                            MinWidth="{Binding ViewportWidth,
                                                       RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Clickable expander (only visible when HasItems). -->
                                            <Border x:Name="ExpanderHit" Grid.Column="0"
                                                    Background="Transparent"
                                                    MouseLeftButtonDown="OnExpanderHit">
                                                <Path x:Name="Expander"
                                                      Data="M 0,0 L 6,4 L 0,8 Z" Fill="{StaticResource TextTertiaryBrush}"
                                                      Width="10" Height="10"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Visibility="Hidden" />
                                            </Border>
                                            <ContentPresenter Grid.Column="1"
                                                              ContentSource="Header"
                                                              HorizontalAlignment="Left"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter x:Name="ItemsHost"
                                                    Margin="16,0,0,0"
                                                    Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Expander" Property="Data" Value="M 0,0 L 8,0 L 4,6 Z" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="ItemsControl.AlternationIndex" Value="1" />
                                            <Condition Property="IsSelected" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource ZebraRowBrush}" />
                                    </MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- Album row: expand triangle (only when there are children) + summary text. -->
                <HierarchicalDataTemplate DataType="{x:Type local:PieceAlbumsWindow+AlbumNode}"
                                          ItemsSource="{Binding TrackHits}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚑" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource ProvisionalBadgeBrush}"
                                   ToolTip="A track on this album has variants with none identified"
                                   Visibility="{Binding NeedsVariant, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Display}" FontSize="11" />
                    </StackPanel>
                </HierarchicalDataTemplate>
                <!-- Loose track row: no children → no expander. -->
                <DataTemplate DataType="{x:Type local:PieceAlbumsWindow+LooseTrackNode}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚑" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource ProvisionalBadgeBrush}"
                                   ToolTip="This piece has variants — none identified for this recording"
                                   Visibility="{Binding NeedsVariant, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Display}" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
                <!-- Track-hit child of an album: indented under its album row. -->
                <DataTemplate DataType="{x:Type local:PieceAlbumsWindow+TrackHitNode}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚑" FontSize="11" Margin="0,0,5,0" Foreground="{StaticResource ProvisionalBadgeBrush}"
                                   ToolTip="This piece has variants — none identified for this recording"
                                   Visibility="{Binding NeedsVariant, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Display}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>
    </DockPanel>
</Window>
