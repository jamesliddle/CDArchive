<Window x:Class="CDArchive.App.Views.MusicBrainzReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
        xmlns:controls="clr-namespace:CDArchive.App.Views.Controls"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Title="Review MusicBrainz suggestions"
        Width="1080" Height="720"
        MinWidth="780" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- SectionHeaderBrush now lives in Themes/Theme.xaml (shared). The
             section-header reference below resolves to it at app scope. -->

        <!-- Per-row card border. -->
        <SolidColorBrush x:Key="CardBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FAFAFA" />

        <!-- Confidence formatting brush (green = high-confidence match). -->
        <SolidColorBrush x:Key="HighConfidenceBrush" Color="#1F7A1F" />
    </Window.Resources>

    <DockPanel>

        <!-- Bottom action bar (fixed) -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource StatusBarBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel>
                <!-- Live progress band shown while planner is running -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsPlanning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Planning…" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                        <Run Text="Albums "/>
                        <Run Text="{Binding Progress.AlbumsResolved, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding Progress.AlbumsTotal, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="  ·  Composers "/>
                        <Run Text="{Binding Progress.ArtistsResolved, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding Progress.ArtistsTotal, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="  ·  Pieces "/>
                        <Run Text="{Binding Progress.WorksResolved, Mode=OneWay, FallbackValue=0}"/>
                        <Run Text="/"/>
                        <Run Text="{Binding Progress.WorksTotal, Mode=OneWay, FallbackValue=0}"/>
                    </TextBlock>
                    <Button Content="Stop" Margin="12,0,0,0" Padding="8,2" FontSize="11"
                            Command="{Binding StopCommand}"
                            ToolTip="Stop the planner and review whatever was resolved so far." />
                </StackPanel>

                <!-- Right-side actions -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Apply none" Width="100" Padding="0,6" Margin="0,0,8,0"
                            Command="{Binding ApplyNoneCommand}"
                            ToolTip="Import without applying any MusicBrainz enrichment." />
                    <Button Content="Cancel" Width="80" Padding="0,6" Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            IsCancel="True" />
                    <Button Content="Apply" Width="80" Padding="0,6"
                            Command="{Binding ApplyCommand}"
                            IsDefault="True" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top "Jump to" toolbar (fixed) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource StatusBarBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Jump to:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Padding="6,2" Margin="0,0,6,0" FontSize="11"
                        Click="OnJumpToAlbums">
                    <TextBlock>
                        <Run Text="Albums ("/><Run Text="{Binding AlbumsTotal, Mode=OneWay}"/><Run Text=")"/>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Border>

        <!-- Zero-hit banner: surfaces clearly when no album in this import
             got any MB match, so the user doesn't have to scroll through
             empty cards to realise something's wrong. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ErrorBgBrush}" BorderBrush="{StaticResource ErrorBorderBrush}"
                BorderThickness="0,0,0,1" Padding="14,10"
                Visibility="{Binding AllAlbumsLackCandidates, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource ErrorTextBrush}"
                           Text="No MusicBrainz matches" Margin="0,0,0,4" />
                <TextBlock FontSize="11" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap">
                    MusicBrainz returned zero candidates for every album in this import.
                    Possible causes: query format mismatch, no network access, or these
                    releases really aren't in MB. Try Settings → "Test MusicBrainz
                    connectivity" to rule out connectivity. The exact query and hit
                    count for each album are logged to
                    <Run FontFamily="Consolas, Cascadia Mono, monospace"
                         Text="%LocalAppData%\CDArchive\logs\cdarchive-YYYYMMDD.log"/>.
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Main scrollable section stack -->
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">

                <!-- ── Section: Albums ──────────────────────────────────── -->
                <Border x:Name="AlbumsSectionAnchor"
                        Background="{StaticResource SectionHeaderBrush}"
                        Padding="10,6" Margin="0,0,0,4">
                    <TextBlock FontWeight="SemiBold" FontSize="10">
                        <Run Text="Albums ("/><Run Text="{Binding AlbumsTotal, Mode=OneWay}"/>
                        <Run Text=" proposals)"/>
                    </TextBlock>
                </Border>

                <ItemsControl ItemsSource="{Binding AlbumRows}" Margin="0,0,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AlbumRowViewModel}">
                            <Border BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1" Background="{StaticResource CardBackgroundBrush}"
                                    Margin="0,2" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- iTunes side -->
                                    <TextBlock Grid.Row="0" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                        <Run Text="iTunes: "/>
                                        <Run Text="{Binding Proposal.ItunesAlbumTitle, Mode=OneWay}"
                                             FontWeight="SemiBold"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Proposal.ItunesAlbumArtist, Mode=OneWay}"/>
                                        <Run Text="  ("/>
                                        <Run Text="{Binding Proposal.TrackCount, Mode=OneWay}"/>
                                        <Run Text=" tracks)"/>
                                    </TextBlock>

                                    <!-- MB candidate selector -->
                                    <DockPanel Grid.Row="1" Margin="0,4,0,0"
                                               Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="MB:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox Width="500" FontSize="11"
                                                  ItemsSource="{Binding Candidates}"
                                                  SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="11">
                                                        <Run Text="{Binding Title, Mode=OneWay}"/>
                                                        <Run Text=" — "/>
                                                        <Run Text="{Binding ArtistCredit, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Label, Mode=OneWay}"/>
                                                        <Run Text=" "/>
                                                        <Run Text="{Binding CatalogueNumber, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding Date, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <!-- Confidence badge -->
                                        <TextBlock Margin="10,0,0,0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding SelectedCandidate.Confidence, StringFormat='conf: {0:P0}', Mode=OneWay, FallbackValue=''}" />
                                        <!-- MBID linkage chip — read-only, click to open -->
                                        <controls:MusicBrainzIdDisplay
                                            Mbid="{Binding SelectedCandidate.MbReleaseId, Mode=OneWay}"
                                            EntityKind="release"
                                            Margin="10,0,0,0" />
                                    </DockPanel>

                                    <!-- Per-aspect Apply checkboxes -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="Metadata" FontSize="11" Margin="0,0,12,0"
                                                  IsChecked="{Binding ApplyMetadata, Mode=TwoWay}"
                                                  ToolTip="Apply Label / Catalogue Number / Barcode." />
                                        <CheckBox Content="Performers" FontSize="11" Margin="0,0,12,0"
                                                  IsChecked="{Binding ApplyPerformers, Mode=TwoWay}"
                                                  ToolTip="Apply conductor / orchestra / soloist credits." />
                                        <CheckBox Content="Recording session" FontSize="11"
                                                  IsChecked="{Binding ApplyRecordingSession, Mode=TwoWay}"
                                                  ToolTip="Apply recording dates / venue / engineers / producers." />
                                        <TextBlock Margin="14,0,0,0" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="Loading details…"
                                                   Visibility="{Binding IsLoadingDetail, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- Preview pane: shows full release detail once the
                                         per-row detail fetch completes. Driven by HasDetail
                                         so the row stays compact until MB returns data. -->
                                    <Border Grid.Row="3" Margin="0,8,0,0" Padding="10,6"
                                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource SubtleBorderBrush}"
                                            BorderThickness="1"
                                            Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                                       FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{StaticResource InfoTextBrush}" Margin="0,0,0,4"
                                                       Text="Selected candidate" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Title"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11"
                                                       Text="{Binding SelectedCandidateDetail.Title, Mode=OneWay}" />

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Artist"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding SelectedCandidateDetail.ArtistCredit, Mode=OneWay}" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Label / CatNo"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="11">
                                                <Run Text="{Binding SelectedCandidateDetail.Label, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding SelectedCandidateDetail.CatalogueNumber, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Barcode"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Row="4" Grid.Column="1" FontSize="11"
                                                       Text="{Binding SelectedCandidateDetail.Barcode, Mode=OneWay}" />

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Date / Country"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" FontSize="11">
                                                <Run Text="{Binding SelectedCandidateDetail.Date, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding SelectedCandidateDetail.Country, Mode=OneWay}"/>
                                            </TextBlock>

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Discs / Tracks"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" FontSize="11">
                                                <Run Text="{Binding SelectedCandidateDetail.DiscCount, Mode=OneWay}"/>
                                                <Run Text=" disc(s), "/>
                                                <Run Text="{Binding SelectedCandidateDetail.TrackCount, Mode=OneWay}"/>
                                                <Run Text=" track(s)"/>
                                            </TextBlock>

                                            <!-- Recording session(s) — typically one entry; lists multiple
                                                 when MB credits per-track sessions. -->
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="Sessions"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <ItemsControl Grid.Row="7" Grid.Column="1"
                                                          ItemsSource="{Binding SelectedCandidateDetail.RecordingEvents, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,1">
                                                            <Run Text="{Binding Date, Mode=OneWay}"/>
                                                            <Run Text=" — "/>
                                                            <Run Text="{Binding Venue, Mode=OneWay}"/>
                                                            <Run Text=", "/>
                                                            <Run Text="{Binding City, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Performer credits with role + instrument. -->
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Credits"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <ItemsControl Grid.Row="8" Grid.Column="1"
                                                          ItemsSource="{Binding SelectedCandidateDetail.Credits, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,1">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text=" — "/>
                                                            <Run Text="{Binding Role, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- iTunes vs MB tracks: two-column side-by-side for
                                                 direct comparison. iTunes side is the import selection;
                                                 MB side is the chosen release's canonical listing.
                                                 Mismatched counts (different bonus tracks, MB has
                                                 extra discs, etc.) make this the clearest visual
                                                 verification the user can do before applying. -->
                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="Tracks"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Top" Margin="0,4,0,0" />
                                            <Grid Grid.Row="9" Grid.Column="1" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0"
                                                           FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontWeight="SemiBold" Margin="0,0,0,2"
                                                           Text="iTunes (your import selection)" />
                                                <TextBlock Grid.Row="0" Grid.Column="2"
                                                           FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"
                                                           FontWeight="SemiBold" Margin="0,0,0,2"
                                                           Text="MusicBrainz release" />

                                                <ItemsControl Grid.Row="1" Grid.Column="0"
                                                              ItemsSource="{Binding Proposal.ItunesTracks, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="10"
                                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0">
                                                                <Run Text="{Binding DiscNumber, Mode=OneWay, FallbackValue=1}"/>
                                                                <Run Text="."/>
                                                                <Run Text="{Binding TrackNumber, Mode=OneWay}"/>
                                                                <Run Text="  "/>
                                                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <ItemsControl Grid.Row="1" Grid.Column="2"
                                                              ItemsSource="{Binding SelectedCandidateDetail.Tracks, Mode=OneWay}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="10"
                                                                       FontFamily="Consolas, Cascadia Mono, monospace"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0">
                                                                <Run Text="{Binding DiscNumber, Mode=OneWay}"/>
                                                                <Run Text="."/>
                                                                <Run Text="{Binding TrackNumber, Mode=OneWay}"/>
                                                                <Run Text="  "/>
                                                                <Run Text="{Binding Title, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- No-match indicator -->
                                    <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="11"
                                               Foreground="{StaticResource TextTertiaryBrush}" FontStyle="Italic"
                                               Text="MusicBrainz found no candidates for this album."
                                               Visibility="{Binding LacksCandidates, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ── Warnings ──────────────────────────────────────────── -->
                <Border Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                        Padding="10,6" Margin="0,8,0,0"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Warnings" FontWeight="SemiBold" FontSize="11"
                                   Foreground="{StaticResource WarningTextBrush}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" Foreground="{StaticResource WarningTextBrush}"
                                               TextWrapping="Wrap" Margin="0,1">
                                        <Run Text="·"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
