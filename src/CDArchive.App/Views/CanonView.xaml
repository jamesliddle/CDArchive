<UserControl x:Class="CDArchive.App.Views.CanonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:local="clr-namespace:CDArchive.Core.Models;assembly=CDArchive.Core"
             xmlns:conv="clr-namespace:CDArchive.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CanonViewModel}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <conv:HitCountBadgeConverter x:Key="HitBadge" />
    </UserControl.Resources>

    <DockPanel>
        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource StatusBarBrush}" Padding="10,6"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <DockPanel Margin="5,10,5,5">

            <!-- ── Toolbar (two rows) ── -->
            <!--
                Column map (shared across both rows for alignment):
                  0 = Refresh icon   1 = gap
                  2 = New btn        3 = gap
                  4 = Delete btn     5 = gap
                  6 = Sort label     7 = Sort dropdown
                  8 = gap            9 = Filter label   10 = Filter box
            -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />  <!-- 0: Refresh -->
                    <ColumnDefinition Width="8"    />  <!-- 1 -->
                    <ColumnDefinition Width="Auto" />  <!-- 2: New Composer / New Piece -->
                    <ColumnDefinition Width="8"    />  <!-- 3 -->
                    <ColumnDefinition Width="Auto" />  <!-- 4: Delete Composer / Delete Piece -->
                    <ColumnDefinition Width="16"   />  <!-- 5 -->
                    <ColumnDefinition Width="Auto" />  <!-- 6: Sort label -->
                    <ColumnDefinition Width="90"   />  <!-- 7: Sort dropdown -->
                    <ColumnDefinition Width="16"   />  <!-- 8 -->
                    <ColumnDefinition Width="Auto" />  <!-- 9: Filter label -->
                    <ColumnDefinition Width="150"  />  <!-- 10: Filter box -->
                    <ColumnDefinition Width="16"   />  <!-- 11 -->
                    <ColumnDefinition Width="Auto" />  <!-- 12: Show label -->
                    <ColumnDefinition Width="90"   />  <!-- 13: Show dropdown -->
                </Grid.ColumnDefinitions>

                <!-- ── Row 0: Refresh · New Composer · Delete Composer · Sort Composers · Filter ── -->
                <Button Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                        Width="32" Height="28"
                        Command="{Binding LoadDataCommand}"
                        ToolTip="Reload all data from the database" />

                <Button Grid.Row="0" Grid.Column="2"
                        Content="New Composer" Padding="12,4" FontSize="10" Height="28"
                        Click="OnNewComposerClick" />

                <Button Grid.Row="0" Grid.Column="4"
                        Content="Delete Composer" Padding="12,4" FontSize="10" Height="28"
                        Foreground="{StaticResource DangerBrush}"
                        Click="OnDeleteComposerClick" />

                <TextBlock Grid.Row="0" Grid.Column="6"
                           Text="Sort Composers:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Row="0" Grid.Column="7"
                          FontSize="10" Height="23"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding ComposerSortColumn}">
                    <ComboBoxItem Content="Pieces" />
                    <ComboBoxItem Content="Recordings" />
                    <ComboBoxItem Content="Name" />
                    <ComboBoxItem Content="Born" />
                    <ComboBoxItem Content="Died" />
                </ComboBox>

                <TextBlock Grid.Row="0" Grid.Column="9"
                           Text="Filter:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Row="0" Grid.Column="10"
                         Text="{Binding ComposerFilter, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="11" Padding="6,4" />

                <TextBlock Grid.Row="0" Grid.Column="12"
                           Text="Show:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Row="0" Grid.Column="13"
                          FontSize="10" Height="23"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding ComposerProvisionalFilter}">
                    <ComboBoxItem Content="All"         Tag="{x:Static vm:ProvisionalFilter.All}" />
                    <ComboBoxItem Content="Provisional" Tag="{x:Static vm:ProvisionalFilter.Provisional}" />
                    <ComboBoxItem Content="Accepted"    Tag="{x:Static vm:ProvisionalFilter.Accepted}" />
                </ComboBox>

                <!-- ── Row 2: New Piece · Delete Piece · Sort Pieces ── -->
                <Button Grid.Row="2" Grid.Column="2"
                        x:Name="NewPieceButton" Content="New Piece"
                        Padding="12,4" FontSize="10" Height="28"
                        IsEnabled="False"
                        Click="OnNewPieceClick" />

                <Button Grid.Row="2" Grid.Column="4"
                        x:Name="DeletePieceButton" Content="Delete Piece"
                        Padding="12,4" FontSize="10" Height="28"
                        IsEnabled="False" Foreground="{StaticResource DangerBrush}"
                        Click="OnDeletePieceClick" />

                <TextBlock Grid.Row="2" Grid.Column="6"
                           Text="Sort Pieces:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Row="2" Grid.Column="7"
                          FontSize="10" Height="23"
                          SelectedValuePath="Content"
                          SelectedValue="{Binding PieceSortColumn}">
                    <ComboBoxItem Content="Catalogue" />
                    <ComboBoxItem Content="Title" />
                    <ComboBoxItem Content="Category" />
                    <ComboBoxItem Content="Year" />
                    <ComboBoxItem Content="Recordings" />
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="12"
                           Text="Show:" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Row="2" Grid.Column="13"
                          FontSize="10" Height="23"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding PieceProvisionalFilter}">
                    <ComboBoxItem Content="All"         Tag="{x:Static vm:ProvisionalFilter.All}" />
                    <ComboBoxItem Content="Provisional" Tag="{x:Static vm:ProvisionalFilter.Provisional}" />
                    <ComboBoxItem Content="Accepted"    Tag="{x:Static vm:ProvisionalFilter.Accepted}" />
                </ComboBox>
            </Grid>

            <!-- ── Single unified tree panel ── -->
            <Border BorderThickness="1" BorderBrush="{StaticResource SubtleBorderBrush}" Background="{StaticResource SurfaceBrush}">
                <DockPanel>

                    <!-- Composer column headers -->
                    <Grid DockPanel.Dock="Top" Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19" />               <!-- expander space -->
                            <ColumnDefinition Width="65" MinWidth="50" /> <!-- Pieces -->
                            <ColumnDefinition Width="Auto" />             <!-- splitter -->
                            <ColumnDefinition Width="*" MinWidth="100" /> <!-- Name -->
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" x:Name="LHdrExpander" />

                        <Border Grid.Column="1" x:Name="LHdrPieces">
                            <TextBlock Text="Pieces" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Right" Margin="0,0,8,0" />
                        </Border>

                        <GridSplitter Grid.Column="2" Width="4" Background="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Cursor="SizeWE" />

                        <Border Grid.Column="3" x:Name="LHdrName">
                            <TextBlock Text="Name" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                    </Grid>

                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource SubtleBorderBrush}"
                            BorderThickness="0,0,0,1" Margin="0,0,0,2" />

                    <!-- ── Unified tree: Composer → Piece → Subpiece/Version ── -->
                    <!-- Rework H34: virtualization is the WPF default. Pre-fix
                         this tree set IsVirtualizing="False" to work around an
                         Items.Refresh() expansion-state collapse; that's now
                         handled by SaveAllExpansionState / RestoreAllExpansionState
                         in the code-behind. With virtualization off, every
                         TreeViewItem for every collapsed-or-visible node was
                         realized at construction — tens of thousands of WPF
                         containers on a fully-loaded catalogue. -->
                    <TreeView x:Name="ComposerTree"
                              BorderThickness="0" Background="{StaticResource SurfaceBrush}"
                              FontSize="11"
                              AlternationCount="2"
                              SelectedItemChanged="OnComposerTreeSelectionChanged"
                              MouseRightButtonDown="OnTreeMouseRightButtonDown"
                              ContextMenuOpening="OnTreeContextMenuOpening"
                              KeyDown="OnTreeKeyDown"
                              RequestBringIntoView="OnTreeRequestBringIntoView">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="CtxEdit"
                                          Header="Edit" Click="OnContextEdit" />
                                <MenuItem x:Name="CtxShowAlbums"
                                          Header="Show Albums…" Click="OnContextShowAlbums" />
                                <Separator />
                                <MenuItem x:Name="CtxExpandAll"
                                          Header="Expand all below"
                                          Click="OnContextExpandAll" />
                                <MenuItem x:Name="CtxCollapseAll"
                                          Header="Collapse all below"
                                          Click="OnContextCollapseAll" />
                                <Separator />
                                <MenuItem x:Name="CtxApprove"
                                          Header="Approve" Click="OnContextApprove" />
                                <MenuItem x:Name="CtxReject"
                                          Header="Reject" Click="OnContextReject" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.Template>
                            <ControlTemplate TargetType="TreeView">
                                <ScrollViewer Focusable="False" CanContentScroll="False"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto" Padding="0">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </TreeView.Template>
                        <TreeView.Resources>

                            <!-- Expander arrow (Path + one-way DataTrigger).
                                 A plain Path avoids the TwoWay ToggleButton.IsChecked ↔
                                 TreeViewItem.IsExpanded binding, which was fragile: WPF's
                                 IsEnabled-propagation during ShowDialog() owner-disable could
                                 briefly reset IsChecked, and the TwoWay path then collapsed
                                 every expanded row.  With a DataTrigger the arrow reflects
                                 IsExpanded read-only; toggling is done by OnExpanderBorderMouseDown. -->
                            <Style x:Key="ExpanderArrow" TargetType="Path">
                                <Setter Property="Data"                Value="M 0,0 L 6,4 L 0,8 Z" />
                                <Setter Property="Fill"                Value="{StaticResource TextTertiaryBrush}" />
                                <Setter Property="Width"               Value="10" />
                                <Setter Property="Height"              Value="10" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment"   Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded,
                                                     RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                 Value="True">
                                        <Setter Property="Data" Value="M 0,0 L 8,0 L 4,6 Z" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Custom TreeViewItem style -->
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <!-- MinWidth binding makes the zebra row background stretch
                                                     to the full viewport width while preserving horizontal
                                                     scrolling when content exceeds the viewport. -->
                                                <Border x:Name="Bd" Background="Transparent" Padding="0,1"
                                                        MinWidth="{Binding ViewportWidth,
                                                                   RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" />
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Margin="19,0,0,0"
                                                                Visibility="Collapsed" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <!-- iTunes-style zebra stripe.
                                                     AlternationIndex resets per tree level, so this
                                                     stripes top-level composer rows cleanly; expanded
                                                     children alternate among themselves starting at 0
                                                     (a WPF limitation, not a bug). -->
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="ItemsControl.AlternationIndex" Value="1" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                        <Condition Property="IsMouseOver" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource ZebraRowBrush}" />
                                                </MultiTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFillBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="MouseDoubleClick" Handler="OnTreeItemDoubleClick" />
                            </Style>

                            <!-- ── Level 1: Composer node ── -->
                            <HierarchicalDataTemplate DataType="{x:Type vm:ComposerTreeNode}"
                                                      ItemsSource="{Binding AllItems}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Border Width="19" Background="Transparent"
                                            MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                        <Path Style="{StaticResource ExpanderArrow}" />
                                    </Border>
                                    <Border Width="65">
                                        <TextBlock Text="{Binding Composer.PieceCount}"
                                                   TextAlignment="Right" Margin="0,0,8,0"
                                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="10" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Composer.Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Composer.IsProvisional,
                                                                Converter={StaticResource ProvisionalBrush}}" />
                                        <TextBlock Text="{Binding Composer.LifeSpan}"
                                                   Foreground="{StaticResource TextTertiaryBrush}" FontSize="10"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                                   Foreground="{StaticResource ApprovedBadgeBrush}" FontSize="9"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ── Level 2: Piece node (expands to show subpieces) ── -->
                            <HierarchicalDataTemplate DataType="{x:Type local:CanonPiece}"
                                                      ItemsSource="{Binding TreeChildren}">
                                <StackPanel Orientation="Horizontal" Margin="0,0">
                                    <!--
                                        The TreeViewItem indent is 19 px (= LHdrExpander width).
                                        We mirror the LHdrPieces column with a same-width Border so
                                        the title lands exactly on the Name column.  The expander
                                        sits right-aligned inside that placeholder; 4 px after it
                                        matches the GridSplitter between the Pieces and Name columns.
                                    -->
                                    <Border Width="65">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Right"
                                              Background="Transparent"
                                              MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                            <Path Style="{StaticResource ExpanderArrow}"
                                                  Visibility="{Binding HasTreeChildren,
                                                      Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" /> <!-- matches the GridSplitter column -->
                                    <TextBlock Text="{Binding DisplayTitleShort}"
                                               FontSize="10"
                                               Foreground="{Binding IsProvisional,
                                                            Converter={StaticResource ProvisionalBrush}}">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="600">
                                                <TextBlock Text="{Binding ToolTipText}"
                                                           TextWrapping="Wrap" FontSize="11" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Catalog}"
                                               FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                               FontSize="9" Foreground="{StaticResource ApprovedBadgeBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ── Level 3: Subpiece / movement node ── -->
                            <!--
                                The TreeViewItem style indents every level's children by 19 px.
                                By mirroring the same LHdrPieces border + 4 px splitter gap used
                                in the piece template, each deeper level's title lands exactly
                                19 px further right than its parent's title, giving a natural
                                progressive indent that also tracks the Pieces column splitter.
                            -->
                            <HierarchicalDataTemplate DataType="{x:Type local:SubpieceDisplayNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,0">
                                    <Border Width="65">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Right"
                                              Background="Transparent"
                                              MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                            <Path Style="{StaticResource ExpanderArrow}"
                                                  Visibility="{Binding HasChildren,
                                                      Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" />
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="600">
                                                <TextBlock Text="{Binding Piece.ToolTipText}"
                                                           TextWrapping="Wrap" FontSize="11" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Piece.Category}"
                                               FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                               FontSize="9" Foreground="{StaticResource ApprovedBadgeBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ── Level 3 (alt): Original node — represents the piece's own version ── -->
                            <HierarchicalDataTemplate DataType="{x:Type local:PieceOriginalNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,0">
                                    <Border Width="65">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Right"
                                              Background="Transparent"
                                              MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                            <Path Style="{StaticResource ExpanderArrow}"
                                                  Visibility="{Binding HasChildren,
                                                      Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" />
                                    <TextBlock Text="Original"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                               FontSize="9" Foreground="{StaticResource ApprovedBadgeBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ── Level 3 (alt): Version node ── -->
                            <HierarchicalDataTemplate DataType="{x:Type local:VersionDisplayNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,0">
                                    <Border Width="65">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Right"
                                              Background="Transparent"
                                              MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                            <Path Style="{StaticResource ExpanderArrow}"
                                                  Visibility="{Binding HasSubpieces,
                                                      Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" />
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" />
                                    <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                               FontSize="9" Foreground="{StaticResource ApprovedBadgeBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ── Contributed works: role + composer group header ── -->
                            <HierarchicalDataTemplate DataType="{x:Type local:ContributedRoleGroupNode}"
                                                      ItemsSource="{Binding Pieces}">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="65">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Right"
                                              Background="Transparent"
                                              MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                            <Path Style="{StaticResource ExpanderArrow}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" />
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" />
                                    <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                               FontSize="9" Foreground="{StaticResource ApprovedBadgeBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ── Cross-composer subpiece (collaborative work, e.g. Ravel's
                                     Fanfare under L'éventail de Jeanne).
                                     Italic to distinguish from owned works.
                                     Expands to show the cross-credit subpiece's own
                                     subpieces / versions (descendants inherit the
                                     cross-crediting composer per the seeder rule). ── -->
                            <HierarchicalDataTemplate DataType="{x:Type local:CrossComposerSubpieceNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,0">
                                    <Border Width="65">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Right"
                                              Background="Transparent"
                                              MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                            <Path Style="{StaticResource ExpanderArrow}"
                                                  Visibility="{Binding HasChildren,
                                                      Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" />
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontStyle="Italic">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="600">
                                                <TextBlock Text="{Binding Subpiece.ToolTipText}"
                                                           TextWrapping="Wrap" FontSize="11" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Catalog}"
                                               FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                               FontSize="9" Foreground="{StaticResource ApprovedBadgeBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                            <!-- ── Contributed works: piece node under a role group ── -->
                            <HierarchicalDataTemplate DataType="{x:Type local:ContributedPieceNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,0">
                                    <Border Width="65">
                                        <Grid Width="16" Height="16" HorizontalAlignment="Right"
                                              Background="Transparent"
                                              MouseLeftButtonDown="OnExpanderBorderMouseDown">
                                            <Path Style="{StaticResource ExpanderArrow}"
                                                  Visibility="{Binding HasChildren,
                                                      Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                    <Border Width="4" />
                                    <TextBlock Text="{Binding DisplayTitle}"
                                               FontSize="10" Foreground="{StaticResource TextPrimaryBrush}">
                                        <TextBlock.ToolTip>
                                            <ToolTip MaxWidth="600">
                                                <TextBlock Text="{Binding Piece.ToolTipText}"
                                                           TextWrapping="Wrap" FontSize="11" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Catalog}"
                                               FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Converter={StaticResource HitBadge}}"
                                               FontSize="9" Foreground="{StaticResource ApprovedBadgeBrush}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>

                        </TreeView.Resources>
                    </TreeView>

                </DockPanel>
            </Border>

        </DockPanel>
    </DockPanel>
</UserControl>
