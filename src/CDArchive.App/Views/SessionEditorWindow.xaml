<Window x:Class="CDArchive.App.Views.SessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording Session"
        Width="460" Height="700"
        MinWidth="380" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Reuse the same vertical action-button look the AlbumEditor
             lists use, so the two editors feel consistent. -->
        <Style x:Key="ListActionButtonStyle" TargetType="Button">
            <Setter Property="Width"   Value="74" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Margin"  Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="15">

        <!-- OK / Cancel -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Padding="0,6"
                    IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" Width="80" Padding="0,6" Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <StackPanel>

            <!-- ── Free-text fields ─────────────────────────────────────── -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Dates -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dates:"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DatesBox"
                         FontSize="13" Padding="4,3" Margin="0,0,0,8"
                         Text="{Binding Dates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Venue -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Venue:"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="VenueBox"
                         FontSize="13" Padding="4,3" Margin="0,0,0,8"
                         Text="{Binding Venue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- City -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="City:"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="CityBox"
                         FontSize="13" Padding="4,3" Margin="0,0,0,8"
                         Text="{Binding City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!-- State (between City and Country) -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="State:"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="StateBox"
                         FontSize="13" Padding="4,3" Margin="0,0,0,8"
                         Text="{Binding State, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="State or province (e.g. 'CA', 'New York', 'Bavaria')." />

                <!-- Country -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Country:"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="CountryBox"
                         FontSize="13" Padding="4,3" Margin="0,0,0,8"
                         Text="{Binding Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- ── Engineers list ───────────────────────────────────────── -->
            <TextBlock Text="Engineers" FontWeight="SemiBold" FontSize="12"
                       Foreground="#555" Margin="0,6,0,4" />
            <Grid Height="175" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="EngineerList" Grid.Column="0" FontSize="13"
                         BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                         ItemsSource="{Binding Engineers}"
                         SelectionChanged="OnEngineerSelectionChanged"
                         MouseDoubleClick="OnEngineerDoubleClick" />
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <Button x:Name="AddEngineerButton" Content="Add"
                            Style="{StaticResource ListActionButtonStyle}"
                            Click="OnAddEngineer" />
                    <Button x:Name="EditEngineerButton" Content="Edit"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnEditEngineer" />
                    <Button x:Name="RemoveEngineerButton" Content="Remove"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnRemoveEngineer" />
                    <Border Height="1" Background="#DDD" Margin="0,4,0,8" />
                    <Button x:Name="EngineerUpButton" Content="Up"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnEngineerMoveUp" />
                    <Button x:Name="EngineerDownButton" Content="Down"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnEngineerMoveDown" />
                </StackPanel>
            </Grid>

            <!-- ── Producers list ───────────────────────────────────────── -->
            <TextBlock Text="Producers" FontWeight="SemiBold" FontSize="12"
                       Foreground="#555" Margin="0,4,0,4" />
            <Grid Height="175">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="ProducerList" Grid.Column="0" FontSize="13"
                         BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                         ItemsSource="{Binding Producers}"
                         SelectionChanged="OnProducerSelectionChanged"
                         MouseDoubleClick="OnProducerDoubleClick" />
                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <Button x:Name="AddProducerButton" Content="Add"
                            Style="{StaticResource ListActionButtonStyle}"
                            Click="OnAddProducer" />
                    <Button x:Name="EditProducerButton" Content="Edit"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnEditProducer" />
                    <Button x:Name="RemoveProducerButton" Content="Remove"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnRemoveProducer" />
                    <Border Height="1" Background="#DDD" Margin="0,4,0,8" />
                    <Button x:Name="ProducerUpButton" Content="Up"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnProducerMoveUp" />
                    <Button x:Name="ProducerDownButton" Content="Down"
                            Style="{StaticResource ListActionButtonStyle}"
                            IsEnabled="False" Click="OnProducerMoveDown" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </DockPanel>
</Window>
