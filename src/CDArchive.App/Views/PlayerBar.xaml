<UserControl x:Class="CDArchive.App.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:controls="clr-namespace:CDArchive.App.Views.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}">

    <UserControl.Resources>

        <!-- Borderless transport-icon button. Icon glyphs are rendered in Segoe UI Symbol. -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#CCCCCC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <!-- Grey the glyph/content when disabled (the
                                     custom template doesn't inherit WPF's default
                                     disabled appearance). -->
                                <Setter TargetName="BorderElement" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause swaps glyph based on IsPlaying. Default = ▶ (play). -->
        <Style x:Key="PlayPauseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Content" Value="▶" />
            <Setter Property="FontSize" Value="22" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="⏸" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Whole bar greys out (Opacity 0.5) when no track is loaded; transport
         + slider also IsEnabled=False so they don't accept input. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Opacity" Value="1.0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackLoaded}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            Padding="20,10">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Transport buttons (left): prev-track · seek-back · play/pause ·
                 seek-forward · next-track. The prev/next buttons use the
                 ⏮ / ⏭ glyphs (two triangles + bar) and disable when there's no
                 adjacent track. The seek buttons use the circular-arrow
                 SeekGlyph showing the step count. -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <Button Style="{StaticResource TransportButtonStyle}"
                        Content="⏮"
                        ToolTip="Previous track (restarts the current track when past the restart threshold)"
                        IsEnabled="{Binding CanPreviousTrack}"
                        Command="{Binding PreviousTrackCommand}" />
                <Button Style="{StaticResource TransportButtonStyle}"
                        ToolTip="Skip back"
                        IsEnabled="{Binding IsTrackLoaded}"
                        Command="{Binding SeekBackCommand}">
                    <controls:SeekGlyph Seconds="{Binding SeekBackSeconds}" />
                </Button>
                <Button Style="{StaticResource PlayPauseButtonStyle}"
                        ToolTip="Play / Pause"
                        IsEnabled="{Binding IsTrackLoaded}"
                        Command="{Binding PlayPauseCommand}" />
                <Button Style="{StaticResource TransportButtonStyle}"
                        ToolTip="Skip forward"
                        IsEnabled="{Binding IsTrackLoaded}"
                        Command="{Binding SeekForwardCommand}">
                    <controls:SeekGlyph Seconds="{Binding SeekForwardSeconds}" Mirror="True" />
                </Button>
                <Button Style="{StaticResource TransportButtonStyle}"
                        Content="⏭"
                        ToolTip="Next track"
                        IsEnabled="{Binding HasNextTrack}"
                        Command="{Binding NextTrackCommand}" />
            </StackPanel>

            <!-- Right controls: volume. ("Stop after current track" is now a
                 persisted player setting on the Settings screen, not a
                 transport-bar toggle.) -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                <TextBlock Text="🔈" FontFamily="Segoe UI Symbol" FontSize="14"
                           Foreground="#555" VerticalAlignment="Center"
                           Margin="10,0,4,0" />
                <Slider Width="100"
                        Minimum="0" Maximum="1"
                        SmallChange="0.05" LargeChange="0.1"
                        TickFrequency="0.1"
                        Value="{Binding Volume, Mode=TwoWay}"
                        IsMoveToPointEnabled="True"
                        ToolTip="Volume"
                        VerticalAlignment="Center" />
            </StackPanel>

            <!-- Track info (top) + progress slider with time labels (bottom) -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Two-line caption: title (primary font) over a smaller
                     composer / performers / album line. Each line scrolls left
                     on a loop when it's too wide for the centre column; when it
                     fits it sits static and centred.

                     The hover ToolTip on the whole caption is a complete
                     multi-line track summary (album / composer / piece tree /
                     performers); null when nothing is loaded, so no tooltip
                     appears. ShowDuration is bumped so a long summary stays up
                     long enough to read. -->
                <StackPanel Grid.Row="0" Margin="0,0,0,4"
                            Background="Transparent"
                            ToolTip="{Binding TrackTooltip}"
                            ToolTipService.ShowDuration="30000">
                    <controls:MarqueeTextBlock Text="{Binding TrackTitleLine}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Foreground="#333333" />
                    <controls:MarqueeTextBlock Text="{Binding TrackDetailLine}"
                                               FontSize="11"
                                               Foreground="#555555"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding HasTrackDetail,
                                                            Converter={StaticResource BoolToVis}}" />
                    <!-- Line 3: full file path — opt-in via the "Show playing
                         file path" setting. -->
                    <controls:MarqueeTextBlock Text="{Binding PlayingFilePath}"
                                               FontSize="10"
                                               Foreground="#888888"
                                               Margin="0,1,0,0"
                                               Visibility="{Binding ShowFilePath,
                                                            Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Time labels + slider — hidden until a track is loaded so an
                     empty slider with Maximum=0 doesn't render the thumb pinned
                     at the right edge. -->
                <Grid Grid.Row="1"
                      Visibility="{Binding IsTrackLoaded, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ElapsedDisplay}"
                               FontSize="11"
                               Foreground="#666666"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding SliderValue, Mode=TwoWay}"
                            IsEnabled="{Binding IsTrackLoaded}"
                            VerticalAlignment="Center"
                            Thumb.DragStarted="ProgressSlider_DragStarted"
                            Thumb.DragCompleted="ProgressSlider_DragCompleted"
                            PreviewMouseLeftButtonDown="ProgressSlider_PreviewMouseLeftButtonDown" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding RemainingDisplay}"
                               FontSize="11"
                               Foreground="#666666"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
