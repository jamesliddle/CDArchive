<UserControl x:Class="CDArchive.App.Views.PlayerBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}">

    <UserControl.Resources>

        <!-- Borderless transport-icon button. Icon glyphs are rendered in Segoe UI Symbol. -->
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#CCCCCC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Play/Pause swaps glyph based on IsPlaying. Default = ▶ (play). -->
        <Style x:Key="PlayPauseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TransportButtonStyle}">
            <Setter Property="Content" Value="▶" />
            <Setter Property="FontSize" Value="22" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter Property="Content" Value="⏸" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <!-- Whole bar greys out (Opacity 0.5) when no track is loaded; transport
         + slider also IsEnabled=False so they don't accept input. -->
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Opacity" Value="1.0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTrackLoaded}" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            Padding="20,10">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Transport buttons (left) -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                <Button Style="{StaticResource TransportButtonStyle}"
                        Content="⏪"
                        ToolTip="Seek back 10 seconds"
                        IsEnabled="{Binding IsTrackLoaded}"
                        Command="{Binding SeekBackCommand}" />
                <Button Style="{StaticResource PlayPauseButtonStyle}"
                        ToolTip="Play / Pause"
                        IsEnabled="{Binding IsTrackLoaded}"
                        Command="{Binding PlayPauseCommand}" />
                <Button Style="{StaticResource TransportButtonStyle}"
                        Content="⏩"
                        ToolTip="Seek forward 10 seconds"
                        IsEnabled="{Binding IsTrackLoaded}"
                        Command="{Binding SeekForwardCommand}" />
            </StackPanel>

            <!-- Track info (top) + progress slider with time labels (bottom) -->
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Track info line — VM joins Title / Composer / Album with " — ". -->
                <TextBlock Grid.Row="0"
                           Text="{Binding TrackInfoLine}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#333333"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,4" />

                <!-- Time labels + slider -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding ElapsedDisplay}"
                               FontSize="11"
                               Foreground="#666666"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />

                    <Slider x:Name="ProgressSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding SliderValue, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            IsEnabled="{Binding IsTrackLoaded}"
                            VerticalAlignment="Center"
                            Thumb.DragStarted="ProgressSlider_DragStarted"
                            Thumb.DragCompleted="ProgressSlider_DragCompleted"
                            PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding RemainingDisplay}"
                               FontSize="11"
                               Foreground="#666666"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
