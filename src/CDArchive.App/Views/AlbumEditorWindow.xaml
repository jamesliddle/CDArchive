<Window x:Class="CDArchive.App.Views.AlbumEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Title="New Album"
        Width="920" Height="720"
        MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Left-aligned column header (default WPF centers). -->
        <Style x:Key="LeftAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- Right-aligned header for numeric columns. We stretch the
             container and use a HeaderTemplate with TextAlignment="Right"
             because the default GridViewColumnHeader template doesn't
             reliably honour HorizontalContentAlignment="Right" (sort-arrow
             chrome reserves space on the right edge). -->
        <Style x:Key="RightAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="RightAlignedHeaderTemplate">
            <TextBlock Text="{Binding}" TextAlignment="Right" Padding="0,0,8,0" />
        </DataTemplate>

        <!-- Implicit ListViewItem style: stretch the row presenter so each
             cell occupies its full column width. Without this, default
             HorizontalContentAlignment=Center on ListViewItem causes the
             GridViewRowPresenter to auto-size to its content, making
             HorizontalAlignment="Right" on inner TextBlocks have no effect. -->
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Shared button style for the per-list action columns -->
        <Style x:Key="ListActionButtonStyle" TargetType="Button">
            <Setter Property="Width"   Value="80" />
            <Setter Property="Padding" Value="0,5" />
            <Setter Property="Margin"  Value="0,0,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="0">

        <!-- ── Save / Cancel docked at the bottom ─────────────────────────── -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="12,8">
            <Button x:Name="SaveButton" Content="Save" Width="80" Padding="0,6"
                    IsDefault="True" Click="OnSaveClick" />
            <Button Content="Cancel" Width="80" Padding="0,6" Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <!-- ── Scrollable content stack — Details / Performers / Sessions /
             Discs & Tracks, top-to-bottom (no more tabs). ───────────────── -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,12,12,0">
            <StackPanel>

                <!-- ══ Details ═══════════════════════════════════════════════ -->
                <GroupBox Header="Details" Padding="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Title *"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <!-- H13 slice 1: TextBoxes TwoWay-bind to AlbumEditorViewModel.X.Value
                             (MixedField<string>). MixedPlaceholder.Apply() in code-behind
                             still handles the gray-italic chrome + first-edit-clear keystrokes
                             on top of the binding. -->
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox"
                                 Text="{Binding Title.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8" />

                        <!-- Subtitle -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Subtitle"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SubtitleBox"
                                 Text="{Binding Subtitle.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8" />

                        <!-- Label -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Label"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LabelBox"
                                  IsEditable="True"
                                  Text="{Binding Label.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="11" Padding="2,2"
                                  Margin="0,0,0,8" />

                        <!-- Catalogue Number -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Catalogue Number"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CatalogueNumberBox"
                                 Text="{Binding CatalogueNumber.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8" />

                        <!-- Barcode -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Barcode"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="BarcodeBox"
                                 Text="{Binding Barcode.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8" />

                        <!-- Archive Folder (subfolder under the archive root, or an absolute path) -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Archive Folder"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   ToolTip="Folder containing this album's audio files. Leave blank to use the album Title as the folder name (the standard convention). A bare name resolves under the configured archive root; an absolute path is used as-is." />
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="ArchiveFolderBox"
                                 Text="{Binding ArchiveFolder.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 ToolTip="Leave blank to default to the album Title. Override when the on-disk folder name differs (e.g. 'Beethoven Symphonies 1 3 Bernstein' or 'D:\Music\Singles\track')." />

                        <!-- SPARS Code -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="SPARS Code"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Row="6" Grid.Column="1" x:Name="SparsCodeBox"
                                  Width="100" HorizontalAlignment="Left"
                                  FontSize="11" Margin="0,0,0,8"
                                  SelectionChanged="OnSparsCodeChanged"
                                  ToolTip="D=digital, A=analogue: recording / mixing / mastering">
                            <ComboBoxItem Content="DDD" />
                            <ComboBoxItem Content="ADD" />
                            <ComboBoxItem Content="AAD" />
                            <ComboBoxItem Content="Unknown" />
                        </ComboBox>

                        <!-- Stereo -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Stereo"
                                   FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="StereoBox"
                                  Width="120" HorizontalAlignment="Left"
                                  FontSize="11" Margin="0,0,0,8"
                                  SelectionChanged="OnStereoChanged">
                            <ComboBoxItem Content="Unknown" />
                            <ComboBoxItem Content="Stereo" />
                            <ComboBoxItem Content="Mono" />
                        </ComboBox>

                        <!-- Notes -->
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Notes"
                                   FontSize="11" VerticalAlignment="Top"
                                   Margin="0,4,8,0" />
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="NotesBox"
                                 Text="{Binding Notes.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Height="60" FontSize="11" Padding="4,3"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Margin="0,0,0,4" />
                    </Grid>
                </GroupBox>

                <!-- ══ Performers ════════════════════════════════════════════ -->
                <GroupBox x:Name="PerformersGroup" Header="Performers"
                          Padding="8" Margin="0,0,0,10"
                          Visibility="{Binding ShowPerformersSection,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Album-level performers appear on all tracks unless overridden per-track."
                                   FontSize="9" Foreground="#888" TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <Grid Height="175">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ListView x:Name="PerformerList" Grid.Column="0" FontSize="11"
                                      BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                                      AlternationCount="2"
                                      ItemContainerStyle="{StaticResource ZebraListViewItemStyle}"
                                      ItemsSource="{Binding Performers}"
                                      SelectionChanged="OnPerformerSelectionChanged"
                                      MouseDoubleClick="OnPerformerDoubleClick">
                                <ListView.View>
                                    <GridView x:Name="PerformerGridView">
                                        <GridViewColumn Header="Name" Width="200"
                                                        HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="PerformerRoleColumn"
                                                        Header="Role" Width="160"
                                                        HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Role}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Instrument" Width="160"
                                                        HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Instrument}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="AddPerformerButton" Content="Add"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        Click="OnAddPerformer" />
                                <Button x:Name="EditPerformerButton" Content="Edit"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnEditPerformer" />
                                <Button x:Name="RemovePerformerButton" Content="Remove"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnRemovePerformer" />
                                <Border Height="1" Background="#DDD" Margin="0,4,0,8" />
                                <Button x:Name="PerformerUpButton" Content="Up"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnPerformerMoveUp" />
                                <Button x:Name="PerformerDownButton" Content="Down"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnPerformerMoveDown" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </GroupBox>

                <!-- ══ Recording Session ═════════════════════════════════════ -->
                <!-- Session fields used to live in their own modal (the
                     SessionEditorWindow). They're now inlined here: one set
                     of fields per album, with each track allowed to override
                     any of them via the TrackEditor (which eagerly copies
                     the album values into blank track fields on open). -->
                <GroupBox x:Name="SessionsGroup" Header="Recording Session"
                          Padding="8" Margin="0,0,0,10"
                          Visibility="{Binding ShowSessionsSection,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Dates -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Dates"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SessionDatesBox"
                                 Text="{Binding SessionDates.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 ToolTip="Freeform date, e.g. 'March 3–7, 1967', '1955', 'c.1963'." />

                        <!-- Venue -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Venue"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SessionVenueBox"
                                 Text="{Binding SessionVenue.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8" />

                        <!-- City -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="City"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="SessionCityBox"
                                 Text="{Binding SessionCity.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8" />

                        <!-- State -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="State"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="SessionStateBox"
                                 Text="{Binding SessionState.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8"
                                 ToolTip="State or province (e.g. 'CA', 'New York', 'Bavaria')." />

                        <!-- Country -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Country"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="SessionCountryBox"
                                 Text="{Binding SessionCountry.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11" Padding="4,3" Margin="0,0,0,8" />

                        <!-- Engineers list -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Engineers"
                                   FontSize="11" VerticalAlignment="Top" Margin="0,4,8,0" />
                        <Grid Grid.Row="5" Grid.Column="1" Height="175" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="SessionEngineerList" Grid.Column="0" FontSize="11"
                                     BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                                     ItemsSource="{Binding SessionEngineers}"
                                     SelectionChanged="OnSessionEngineerSelectionChanged"
                                     MouseDoubleClick="OnSessionEngineerDoubleClick" />
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="AddSessionEngineerButton" Content="Add"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        Click="OnAddSessionEngineer" />
                                <Button x:Name="EditSessionEngineerButton" Content="Edit"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnEditSessionEngineer" />
                                <Button x:Name="RemoveSessionEngineerButton" Content="Remove"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnRemoveSessionEngineer" />
                                <Border Height="1" Background="#DDD" Margin="0,4,0,4" />
                                <Button x:Name="SessionEngineerUpButton" Content="Up"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionEngineerMoveUp" />
                                <Button x:Name="SessionEngineerDownButton" Content="Down"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionEngineerMoveDown" />
                            </StackPanel>
                        </Grid>

                        <!-- Producers list -->
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Producers"
                                   FontSize="11" VerticalAlignment="Top" Margin="0,4,8,0" />
                        <Grid Grid.Row="6" Grid.Column="1" Height="175">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="SessionProducerList" Grid.Column="0" FontSize="11"
                                     BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                                     ItemsSource="{Binding SessionProducers}"
                                     SelectionChanged="OnSessionProducerSelectionChanged"
                                     MouseDoubleClick="OnSessionProducerDoubleClick" />
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <Button x:Name="AddSessionProducerButton" Content="Add"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        Click="OnAddSessionProducer" />
                                <Button x:Name="EditSessionProducerButton" Content="Edit"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnEditSessionProducer" />
                                <Button x:Name="RemoveSessionProducerButton" Content="Remove"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnRemoveSessionProducer" />
                                <Border Height="1" Background="#DDD" Margin="0,4,0,4" />
                                <Button x:Name="SessionProducerUpButton" Content="Up"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionProducerMoveUp" />
                                <Button x:Name="SessionProducerDownButton" Content="Down"
                                        Style="{StaticResource ListActionButtonStyle}"
                                        IsEnabled="False" Click="OnSessionProducerMoveDown" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- ══ Discs & Tracks ════════════════════════════════════════ -->
                <GroupBox Header="Discs &amp; Tracks" Padding="8" Margin="0,0,0,10">
                    <Grid Height="320">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ListView x:Name="TrackList" Grid.Column="0" FontSize="11"
                                  BorderThickness="1" BorderBrush="#CCC" Margin="0,0,8,0"
                                  AlternationCount="2"
                                  ItemContainerStyle="{StaticResource ZebraListViewItemStyle}"
                                  SelectionMode="Extended"
                                  SelectionChanged="OnTrackSelectionChanged"
                                  MouseDoubleClick="OnTrackDoubleClick">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Play this track" Click="OnContextPlayTrack" />
                                    <MenuItem Header="Play from here"  Click="OnContextPlayFromHere" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn x:Name="AlbumColumn" Header="Album" Width="0"
                                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AlbumTitle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding AlbumTitle}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Disc" Width="45"
                                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DiscNumber}"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Track" Width="45"
                                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Track.TrackNumber}"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Duration" Width="70"
                                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Track.Duration}"
                                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Content" Width="500"
                                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Track.DisplaySummary}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Track.DisplaySummary}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <StackPanel Grid.Column="1" Orientation="Vertical">
                            <Button x:Name="AddDiscButton" Content="Add Disc"
                                    Style="{StaticResource ListActionButtonStyle}"
                                    Click="OnAddDisc" />
                            <Button x:Name="AddTrackButton" Content="Add Track"
                                    Style="{StaticResource ListActionButtonStyle}"
                                    IsEnabled="False" Click="OnAddTrack" />
                            <Button x:Name="EditTrackButton" Content="Edit"
                                    Style="{StaticResource ListActionButtonStyle}"
                                    IsEnabled="False" Click="OnEditTrack" />
                            <Button x:Name="RemoveTrackButton" Content="Remove"
                                    Style="{StaticResource ListActionButtonStyle}"
                                    IsEnabled="False" Click="OnRemoveTrack" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
