<Window x:Class="CDArchive.App.Views.NameInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        Title="Name"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <DockPanel Margin="15">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" Padding="0,6"
                    IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" Width="80" Padding="0,6" Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>

        <DockPanel>
            <TextBlock x:Name="PromptLabel" DockPanel.Dock="Top"
                       Text="Name:" FontSize="11" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" FontSize="11" Padding="4,3" />
        </DockPanel>

    </DockPanel>
</Window>
