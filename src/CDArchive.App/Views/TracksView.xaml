<UserControl x:Class="CDArchive.App.Views.TracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:helpers="clr-namespace:CDArchive.App.Helpers"
             mc:Ignorable="d"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             d:DataContext="{d:DesignInstance Type=vm:TracksViewModel}">

    <UserControl.Resources>
        <!-- Mirror AlbumsView's header styles so this view feels native. See the
             *GridView column alignment* lesson in CLAUDE.md: header styles must
             live at UserControl scope (not in ListView.Resources) so the
             HeaderContainerStyle StaticResource lookup resolves reliably. -->
        <Style x:Key="LeftAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style x:Key="RightAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="RightAlignedHeaderTemplate">
            <TextBlock Text="{Binding}" TextAlignment="Right" Padding="0,0,8,0" />
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,0,1"
                Background="{StaticResource SurfaceBrush}" Padding="0,0,0,10" Margin="0,0,0,10">
            <DockPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="New Track" Padding="12,5" FontSize="11"
                            Margin="0,0,6,0"
                            ToolTip="Add a loose track (singleton, no album)"
                            Click="OnNewTrackClick" />
                    <Button x:Name="EditButton"
                            Content="Edit" Padding="12,5" FontSize="11"
                            Margin="0,0,12,0" IsEnabled="False"
                            ToolTip="Edit the selected track (or bulk-edit the multi-selection)"
                            Click="OnEditTracksClick" />
                    <Button Style="{StaticResource IconButton}"
                            Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                            Width="32" Height="28"
                            ToolTip="Reload all data from the database"
                            Command="{Binding LoadDataCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" FontSize="11" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,8,0" />
                    <TextBox x:Name="FilterBox"
                             Width="280" FontSize="11"
                             VerticalContentAlignment="Center"
                             TextChanged="OnFilterTextChanged" />

                    <TextBlock Text="Show:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="16,0,8,0" />
                    <ComboBox x:Name="ShowCombo" FontSize="11" Width="110"
                              SelectedIndex="0"
                              SelectionChanged="OnShowFilterChanged">
                        <ComboBoxItem Content="All" />
                        <ComboBoxItem Content="Provisional" />
                        <ComboBoxItem Content="Accepted" />
                    </ComboBox>

                    <CheckBox x:Name="NeedsVariantCheck" FontSize="11"
                              Content="Needs variant" VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              ToolTip="Show only tracks whose piece has variants but none identified for the recording"
                              Checked="OnNeedsVariantFilterChanged"
                              Unchecked="OnNeedsVariantFilterChanged" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ── Status bar ──────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource StatusBarBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,1,0,0"
                Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <!-- ── Tracks list ─────────────────────────────────────────────────── -->
        <ListView x:Name="TrackList"
                  FontSize="11"
                  BorderThickness="0"
                  Background="{StaticResource SurfaceBrush}"
                  helpers:AutoSelectFirst.Enabled="True"
                  ItemsSource="{Binding Rows}"
                  SelectionMode="Extended"
                  SelectionChanged="OnTrackSelectionChanged"
                  MouseDoubleClick="OnTrackDoubleClick"
                  GridViewColumnHeader.Click="OnColumnHeaderClick"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">

            <ListView.ContextMenu>
                <!-- H36 (TracksView slice): Approve / Reject are now RelayCommands
                     on TracksViewModel. PlacementTarget.SelectedItems is the
                     standard pattern for passing a ListView's multi-selection
                     from a ContextMenu (ContextMenu lives outside the visual
                     tree, so ElementName won't reach back to the ListView). -->
                <ContextMenu Opened="OnTrackContextMenuOpened">
                    <MenuItem x:Name="CtxEditTrack"
                              Header="Edit"
                              Click="OnContextEditTrack" />
                    <MenuItem x:Name="CtxPlayTrack"
                              Header="Play Track"
                              Click="OnContextPlayTrack" />
                    <Separator />
                    <MenuItem x:Name="CtxApproveTrack"
                              Header="Approve"
                              Command="{Binding PlacementTarget.DataContext.ApproveTracksCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem x:Name="CtxRejectTrack"
                              Header="Reject"
                              Command="{Binding PlacementTarget.DataContext.RejectTracksCommand,
                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.SelectedItems,
                                                          RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </ListView.ContextMenu>

            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding"   Value="0,1" />
                    <Setter Property="MinHeight" Value="18" />
                    <Setter Property="FontSize"  Value="11" />
                    <!-- Stretch row presenter so column-width-sized cells honour
                         HorizontalAlignment="Right" — see the *GridView column
                         alignment* lesson in CLAUDE.md. -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource SelectionBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ItemsControl.AlternationIndex" Value="1" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{StaticResource ZebraRowBrush}" />
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.AlternationCount>2</ListView.AlternationCount>

            <ListView.View>
                <GridView>

                    <!-- Cover-art thumbnail (settings-driven; column width set in
                         code-behind, 0 when off). Resolves from the row's album;
                         loose tracks (no album) show the placeholder. -->
                    <GridViewColumn x:Name="ArtworkColumn" Header="" Width="0">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="{Binding DataContext.ArtworkBoxSize, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        Height="{Binding DataContext.ArtworkBoxSize, RelativeSource={RelativeSource AncestorType=ListView}}"
                                        CornerRadius="4"
                                        Background="{StaticResource RailBackgroundBrush}"
                                        BorderBrush="{StaticResource SubtleBorderBrush}"
                                        BorderThickness="1"
                                        ClipToBounds="True"
                                        HorizontalAlignment="Left"
                                        Margin="0,1"
                                        Visibility="{Binding DataContext.ShowArtwork, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVis}}"
                                        ToolTipService.IsEnabled="{Binding Converter={StaticResource AlbumHasArtwork}}"
                                        ToolTipService.InitialShowDelay="350"
                                        ToolTipService.ShowDuration="120000"
                                        ToolTipService.Placement="Right">
                                    <Border.ToolTip>
                                        <ToolTip Style="{StaticResource ArtworkPreviewToolTip}"
                                                 Content="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
                                    </Border.ToolTip>
                                    <Grid>
                                        <TextBlock Text="&#xEC4F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Converter={StaticResource AlbumArtwork},
                                                        ConverterParameter=96}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Disc" Width="50"
                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DiscDisplay}"
                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Track" Width="50"
                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TrackDisplay}"
                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Composer" Width="200"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Composer}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Composer}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Piece" Width="520"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <!-- Unchosen-variant flag: piece has variants but
                                         none identified for this recording. -->
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="⚑" FontSize="11" Margin="0,0,5,0"
                                               Foreground="{StaticResource ProvisionalBadgeBrush}"
                                               ToolTip="This piece has variants — none identified for this recording"
                                               Visibility="{Binding NeedsVariantIdentification,
                                                            Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Piece}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Piece}"
                                               Foreground="{Binding IsProvisional,
                                                            Converter={StaticResource ProvisionalBrush}}" />
                                </DockPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Album" Width="220"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AlbumTitle}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding AlbumTitle}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Performers" Width="200"
                                    HeaderContainerStyle="{StaticResource LeftAlignedHeader}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PerformerSummary}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding PerformerSummary}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Time" Width="70"
                                    HeaderContainerStyle="{StaticResource RightAlignedHeader}"
                                    HeaderTemplate="{StaticResource RightAlignedHeaderTemplate}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Duration}"
                                           HorizontalAlignment="Right" Margin="0,0,8,0" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</UserControl>
