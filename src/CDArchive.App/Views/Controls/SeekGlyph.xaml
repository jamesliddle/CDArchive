<UserControl x:Class="CDArchive.App.Views.Controls.SeekGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <!-- Overcast-style "skip N seconds" glyph: a circular arrow with the step
         count centred inside. The arrow points counter-clockwise (top-left)
         for "back"; set Mirror="True" to flip it for "forward". -->
    <Viewbox Width="22" Height="22" Stretch="Uniform">
        <Grid Width="24" Height="24">
            <Path x:Name="ArrowPath" Fill="{StaticResource TextSecondaryBrush}"
                  RenderTransformOrigin="0.5,0.5"
                  Data="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="MirrorScale" ScaleX="1" />
                </Path.RenderTransform>
            </Path>
            <TextBlock Text="{Binding Seconds, ElementName=Root}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,2,0,0"
                       FontFamily="{StaticResource AppFontFamily}"
                       FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>
    </Viewbox>
</UserControl>
