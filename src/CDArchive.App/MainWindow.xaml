<Window x:Class="CDArchive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        TextElement.FontFamily="{StaticResource AppFontFamily}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
        xmlns:views="clr-namespace:CDArchive.App.Views"
        mc:Ignorable="d"
        Title="CD Archive Manager"
        Height="700" Width="1120"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <!-- Light-rail navigation item: glyph + label in a pill that fills with
             the accent tint when selected. The MDL2 glyph for each item is
             supplied via Tag (e.g. Tag="&#xE716;") so one template serves all. -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Navigation" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="BorderElement"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="11,8"
                                Margin="8,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph"
                                           Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           Width="24"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="{StaticResource HoverFillBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="{StaticResource AccentTintBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Left Navigation Panel (light rail — Option A) -->
        <Border DockPanel.Dock="Left" Width="212"
                Background="{StaticResource RailBackgroundBrush}"
                BorderBrush="{StaticResource SubtleBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App Title with accent disc glyph -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                            Margin="18,20,18,18">
                    <TextBlock Text="&#xE90B;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <TextBlock Text="CD Archive"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Tag="&#xE716;"
                                 Content="Composers and Authors"
                                 IsChecked="True"
                                 Command="{Binding NavigateToCanonCommand}" />

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Tag="&#xE8F1;"
                                 Content="Albums"
                                 Command="{Binding NavigateToAlbumsCommand}" />

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Tag="&#xEC4F;"
                                 Content="Tracks"
                                 Command="{Binding NavigateToTracksCommand}" />

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Tag="&#xE8B5;"
                                 Content="iTunes Library"
                                 Command="{Binding NavigateToItunesImportCommand}" />

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Tag="&#xE895;"
                                 Content="JSON Import / Export"
                                 Command="{Binding NavigateToImportExportCommand}" />

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Tag="&#xE8FD;"
                                 Content="Pick Lists"
                                 Command="{Binding NavigateToPickListsCommand}" />

                    <RadioButton Style="{StaticResource NavButtonStyle}"
                                 Tag="&#xE713;"
                                 Content="Settings"
                                 Command="{Binding NavigateToSettingsCommand}" />
                </StackPanel>

                <!-- Spacer -->
                <Border />
            </DockPanel>
        </Border>

        <!-- Right Content Area -->
        <Border Background="{StaticResource PageBackgroundBrush}">
            <DockPanel Margin="0">
                <!-- View Title Header -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource SubtleBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="25,16">
                    <TextBlock Text="{Binding CurrentViewTitle}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                </Border>

                <!-- Persistent player bar at the bottom — singleton VM, survives navigation. -->
                <views:PlayerBar DockPanel.Dock="Bottom"
                                 DataContext="{Binding PlayerViewModel}" />

                <!-- Content area: CanonView lives permanently; other views use ContentControl -->
                <Grid Margin="25,20">
                    <!-- CanonView is always alive — shown/hidden without being destroyed.
                         DataContext is CanonViewModel, so Visibility must reach back up to
                         the Window's DataContext (MainViewModel) via RelativeSource. -->
                    <views:CanonView DataContext="{Binding CanonViewModel}"
                                     Visibility="{Binding DataContext.IsCanonViewActive,
                                                  RelativeSource={RelativeSource AncestorType=Window},
                                                  Converter={StaticResource BoolToVis}}" />

                    <!-- Other views: CurrentView=null when Composers is active, so this is empty/non-blocking -->
                    <ContentControl Content="{Binding CurrentView}" />
                </Grid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
