<Application x:Class="CDArchive.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:views="clr-namespace:CDArchive.App.Views"
             xmlns:conv="clr-namespace:CDArchive.App.Converters"
             xmlns:helpers="clr-namespace:CDArchive.App.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ── Theme dictionary (feature/ui-upgrade) ──────────────────────
                 Palette brushes + implicit control styles live here so they
                 cascade app-wide. Merged first so the keys below + every view
                 resolve against it. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- ── Typography ─────────────────────────────────────────────────
             Segoe UI Variable is the Win11 system font (gracefully falls
             back to Segoe UI on Win10). Window roots set
             TextElement.FontFamily="{StaticResource AppFontFamily}" so the
             value flows through every descendant text element. -->
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>

        <!-- ── Shared converters ───────────────────────────────────────────
             Single canonical key. Previously 11 views each declared their
             own <BooleanToVisibilityConverter> inline under three different
             key spellings (BoolToVis / BoolToVisConverter /
             BoolToVisibilityConverter). H37 retired the custom shadow
             converter; this is the framework one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:IsProvisionalToBrushConverter x:Key="ProvisionalBrush" />
        <conv:RefNeedsVariantConverter x:Key="RefNeedsVariant" />
        <!-- Album cover art → ImageSource. Accepts a CanonAlbum (album lists,
             resolves art) or a resolved AlbumArtwork (player bar). Embedded-tag
             art is preferred over a folder image; both decode small + cache. -->
        <conv:AlbumArtworkConverter x:Key="AlbumArtwork" />
        <!-- True when art exists — gates the hover-preview tooltip. -->
        <conv:AlbumHasArtworkConverter x:Key="AlbumHasArtwork" />

        <!-- Hover-preview tooltip: shows the cover at a 512px decode in a small
             card. Each usage sets Content to the album / track.Album /
             CurrentArtwork; the template resolves it via the AlbumArtwork
             converter. Defined here (not Themes/Theme.xaml) so the StaticResource
             reference to AlbumArtwork above resolves. -->
        <Style x:Key="ArtworkPreviewToolTip" TargetType="ToolTip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource StrongBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <Image Source="{Binding Content,
                                            RelativeSource={RelativeSource TemplatedParent},
                                            Converter={StaticResource AlbumArtwork}, ConverterParameter=512}"
                                   MaxWidth="480" MaxHeight="480"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NOTE: the palette brushes (StatusBrush*, SeverityBrush*,
             AccentBrush, ProvisionalBadgeBrush, ApprovedBadgeBrush,
             DangerBrush, ZebraRowBrush) now live in Themes/Theme.xaml so
             they share one source of truth with the control styles. -->

        <!-- Reusable zebra-stripe ItemContainerStyle for ListViews that
             don't need the larger MinHeight/Padding setup AlbumsView and
             TracksView use. Apply via:
                 <ListView AlternationCount="2"
                           ItemContainerStyle="{StaticResource ZebraListViewItemStyle}" /> -->
        <Style x:Key="ZebraListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE5FF" />
                    <Setter Property="Foreground" Value="#000" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="ItemsControl.AlternationIndex" Value="1" />
                        <Condition Property="IsSelected" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource ZebraRowBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Keyboard navigation for lists ──────────────────────────────
             Home / End / PageUp / PageDown drive the list whenever focus is
             inside it (rows, headers, scrollbar) — not just on a row. Applied
             app-wide via implicit styles so every ListBox / ListView / DataGrid
             gets it. ListView derives from ListBox but implicit styles don't
             inherit across types, so it needs its own style; both base on
             ListBox's so future ListBox setters flow through. -->
        <Style x:Key="ListNavBase" TargetType="ListBox">
            <Setter Property="helpers:ListKeyboardNavigation.Enabled" Value="True" />
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource ListNavBase}" />
        <Style TargetType="ListView" BasedOn="{StaticResource ListNavBase}" />
        <Style TargetType="DataGrid">
            <Setter Property="helpers:ListKeyboardNavigation.Enabled" Value="True" />
        </Style>

        <!-- ── ViewModel → View DataTemplates ─────────────────────────── -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlbumsViewModel}">
            <views:AlbumsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TracksViewModel}">
            <views:TracksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItunesImportViewModel}">
            <views:ItunesImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PickListsViewModel}">
            <views:PickListsView />
        </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
