<Application x:Class="CDArchive.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:views="clr-namespace:CDArchive.App.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
<DataTemplate DataType="{x:Type vm:AlbumsViewModel}">
            <views:AlbumsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItunesImportViewModel}">
            <views:ItunesImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PickListsViewModel}">
            <views:PickListsView />
        </DataTemplate>
    </Application.Resources>
</Application>
