<Application x:Class="CDArchive.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CDArchive.App.ViewModels"
             xmlns:views="clr-namespace:CDArchive.App.Views"
             xmlns:conv="clr-namespace:CDArchive.App.Converters"
             xmlns:helpers="clr-namespace:CDArchive.App.Helpers">
    <Application.Resources>
        <!-- ── Typography ─────────────────────────────────────────────────
             Segoe UI Variable is the Win11 system font (gracefully falls
             back to Segoe UI on Win10). Window roots set
             TextElement.FontFamily="{StaticResource AppFontFamily}" so the
             value flows through every descendant text element. -->
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>

        <!-- ── Shared converters ───────────────────────────────────────────
             Single canonical key. Previously 11 views each declared their
             own <BooleanToVisibilityConverter> inline under three different
             key spellings (BoolToVis / BoolToVisConverter /
             BoolToVisibilityConverter). H37 retired the custom shadow
             converter; this is the framework one. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:IsProvisionalToBrushConverter x:Key="ProvisionalBrush" />

        <!-- ── Status brushes (consumed by ConversionStatusToColorConverter
             and ValidationSeverityToColorConverter) ──────────────────────
             Previously hardcoded in C# as Colors.Gray / DodgerBlue / etc.
             (L29). Lives here so a palette change touches XAML, not code. -->
        <SolidColorBrush x:Key="StatusBrushPending"    Color="Gray" />
        <SolidColorBrush x:Key="StatusBrushInProgress" Color="DodgerBlue" />
        <SolidColorBrush x:Key="StatusBrushCompleted" Color="Green" />
        <SolidColorBrush x:Key="StatusBrushFailed"    Color="Red" />
        <SolidColorBrush x:Key="SeverityBrushWarning" Color="Orange" />
        <SolidColorBrush x:Key="SeverityBrushError"   Color="Red" />

        <!-- ── Semantic accent brushes ────────────────────────────────────
             Named so the most-used hex literals across views have one
             place to change. The bulk hex-literal sweep is deferred (see
             Rework.md H35); the foundation exists. -->
        <SolidColorBrush x:Key="AccentBrush"          Color="#007ACC" />
        <SolidColorBrush x:Key="ProvisionalBadgeBrush" Color="#E65100" />
        <SolidColorBrush x:Key="ApprovedBadgeBrush"   Color="#2E7D32" />
        <SolidColorBrush x:Key="DangerBrush"          Color="#D32F2F" />

        <!-- iTunes-style very-light-gray alternating row background.
             Consumed by ListView ItemContainerStyles via
             ItemsControl.AlternationIndex MultiTriggers and by DataGrid
             via AlternatingRowBackground. -->
        <SolidColorBrush x:Key="ZebraRowBrush"        Color="#F4F4F4" />

        <!-- Reusable zebra-stripe ItemContainerStyle for ListViews that
             don't need the larger MinHeight/Padding setup AlbumsView and
             TracksView use. Apply via:
                 <ListView AlternationCount="2"
                           ItemContainerStyle="{StaticResource ZebraListViewItemStyle}" /> -->
        <Style x:Key="ZebraListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CCE5FF" />
                    <Setter Property="Foreground" Value="#000" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="ItemsControl.AlternationIndex" Value="1" />
                        <Condition Property="IsSelected" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource ZebraRowBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── Keyboard navigation for lists ──────────────────────────────
             Home / End / PageUp / PageDown drive the list whenever focus is
             inside it (rows, headers, scrollbar) — not just on a row. Applied
             app-wide via implicit styles so every ListBox / ListView / DataGrid
             gets it. ListView derives from ListBox but implicit styles don't
             inherit across types, so it needs its own style; both base on
             ListBox's so future ListBox setters flow through. -->
        <Style x:Key="ListNavBase" TargetType="ListBox">
            <Setter Property="helpers:ListKeyboardNavigation.Enabled" Value="True" />
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource ListNavBase}" />
        <Style TargetType="ListView" BasedOn="{StaticResource ListNavBase}" />
        <Style TargetType="DataGrid">
            <Setter Property="helpers:ListKeyboardNavigation.Enabled" Value="True" />
        </Style>

        <!-- ── ViewModel → View DataTemplates ─────────────────────────── -->
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlbumsViewModel}">
            <views:AlbumsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TracksViewModel}">
            <views:TracksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ItunesImportViewModel}">
            <views:ItunesImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
            <views:ImportExportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PickListsViewModel}">
            <views:PickListsView />
        </DataTemplate>
    </Application.Resources>
</Application>
